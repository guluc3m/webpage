# Dependencies — restored by `pnpm install` from the lockfile.
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output — `astro build` regenerates it.
dist/
/build

# Astro's generated types / content cache.
.astro/

# Local env files. Nothing in this static site needs secrets, but never commit them.
.env
.env.*
!.env.example

# Logs
*-debug.log*

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# local OG preview outputs
/temp/
