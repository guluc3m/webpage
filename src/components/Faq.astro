---
/**
 * Faq — frequently asked questions.
 *
 * Uses native <details>/<summary> so it works without JavaScript.
 * TODO! : real questions and answers (placeholders for now).
 */
const items = [
  { q: '¿Cómo me apunto al GUL?', a: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.' },
  {
    q: '¿Hay que saber Linux?',
    a: 'Sed non risus. Suspendisse lectus tortor, dignissim sit amet.',
  },
  { q: '¿Cuándo quedáis?', a: 'Cras elementum ultrices diam. Maecenas ligula massa, varius a.' },
];
---

<section id="faq" class="mx-auto max-w-3xl p-8">
  <h2 class="text-3xl font-bold text-gul-ink">FAQ</h2>
  <p>gul@uc3m $> man faq</p>
  <div class="mt-4 space-y-2">
    {items.map((item) => (
      <details class="rounded-2xl border border-gul-line bg-gul-surface p-4 open:border-gul-ink/30">
        <summary class="cursor-pointer font-medium text-gul-ink marker:text-gul-muted">
          {item.q}
        </summary>
        <p class="mt-2 text-gul-muted">{item.a}</p>
      </details>
    ))}
  </div>
</section>
