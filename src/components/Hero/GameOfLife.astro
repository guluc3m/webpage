---
/**
 * GameOfLife — Conway's Game of Life on a <canvas>, used as the Hero background.
 *
 * Constraints:
 *  - cheap: big cells, low frame rate, no per-pixel work
 *  - pauses when scrolled out of view (IntersectionObserver)
 *  - respects `prefers-reduced-motion`: draws one static frame, never animates
 *  - ignores resize events caused by browser zoom (only DPR-stable resizes
 *    rebuild the grid) — otherwise zooming out inflates cols x rows and the
 *    O(cols*rows) simulation stalls the page
 *
 * It fills its positioned parent. Put it behind content with absolute positioning
 * from the parent side.
 */
import { readFileSync } from 'node:fs';
import { computeTuxBitmap } from '../../lib/tuxBitmap.ts';

// Rasterized once per build, not per visitor — see src/lib/tux.ts.
const tuxSvg = readFileSync(new URL('../../../public/tux.svg', import.meta.url));
const tuxBitmap = await computeTuxBitmap(tuxSvg, 100, 70); // 100 = bitmap height in units, not screen px; 70 = alpha threshold, tuned by eye
---

<canvas
  data-game-of-life
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 h-full w-full"
></canvas>

<script define:vars={{ tuxBitmap }}>
  // define:vars only works on a plain inline script (no bundling, no imports) —
  // stash the value so the module script below (which needs to import
  // sampleTuxMask) can read it.
  window.__tuxBitmap = tuxBitmap;
</script>

<script>
  import { sampleTuxMask, type TuxBitmap } from '../../lib/tux.ts';

  declare global {
    interface Window {
      __tuxBitmap: TuxBitmap;
    }
  }

  const CELL = 12; // px per cell (square + gap) — bigger = cheaper
  const GAP = 2.5; // px gap between squares — 0 for a solid grid
  const DENSITY = 0.2; // fraction of cells alive on the first frame
  const STEP_MS = 140; // ms per generation — lower = faster animation
  // Alive-cell gradient stops, [offset 0-1, color]. Applied once across the whole
  // canvas (not per-cell) so cells read as cut-outs of one continuous gradient.
  const ALIVE_GRADIENT: [number, string][] = [
    [0, 'rgba(236, 231, 216, 0.34)'], // --color-gul-ink, dim
    [1, 'rgba(156, 152, 140, 0.14)'], // --color-gul-muted, less dim so it stays visible
  ];
  const DEAD_FILL = '#0a0a09'; // dead-cell squares — --color-gul-bg, solid (not transparent)
  const GRID_FILL = 'transparent'; // canvas background, i.e. the gaps between squares

  // Tux silhouette overlay: a fixed set of cells always reads as Tux, regardless of
  // whether the automaton underneath is alive or dead there — the life logic still
  // runs on the full grid, only draw() overrides these cells' color. tuxBitmap
  // itself is precomputed at build time (see src/lib/tux.ts) — the client only
  // resamples it to the current grid resolution, no SVG decoding here.
  const TUX_FILL = '#ece7d8'; // --color-gul-ink, solid
  const TUX_HEIGHT_FRACTION = 1.0; // fraction of the grid's rows Tux's height fills

  const canvas = document.querySelector<HTMLCanvasElement>('[data-game-of-life]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let cols = 0;
    let rows = 0;
    let grid: Uint8Array = new Uint8Array(0);
    let aliveFill: CanvasGradient;
    let tuxMask: Uint8Array = new Uint8Array(0);

    const idx = (x: number, y: number) => y * cols + x;

    function reset() {
      // Match the backing store to the element's real size (parent-driven).
      const { width, height } = canvas!.getBoundingClientRect();
      canvas!.width = width;
      canvas!.height = height;
      cols = Math.max(1, Math.ceil(width / CELL));
      rows = Math.max(1, Math.ceil(height / CELL));
      grid = new Uint8Array(cols * rows);
      for (let i = 0; i < grid.length; i++) grid[i] = Math.random() < DENSITY ? 1 : 0;
      // Diagonal top-right → bottom-left; depends on canvas size, rebuilt on resize.
      aliveFill = ctx!.createLinearGradient(width, 0, 0, height);
      for (const [offset, color] of ALIVE_GRADIENT) aliveFill.addColorStop(offset, color);
      tuxMask = sampleTuxMask(window.__tuxBitmap, cols, rows, TUX_HEIGHT_FRACTION);
      draw();
    }

    function step() {
      const next = new Uint8Array(grid.length);
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          let n = 0;
          for (let dy = -1; dy <= 1; dy++) {
            for (let dx = -1; dx <= 1; dx++) {
              if (dx === 0 && dy === 0) continue;
              // Toroidal wrap keeps the field alive without edge handling.
              const nx = (x + dx + cols) % cols;
              const ny = (y + dy + rows) % rows;
              n += grid[idx(nx, ny)];
            }
          }
          const alive = grid[idx(x, y)];
          next[idx(x, y)] = n === 3 || (alive && n === 2) ? 1 : 0;
        }
      }
      grid = next;
    }

    function draw() {
      ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
      ctx!.fillStyle = GRID_FILL;
      ctx!.fillRect(0, 0, canvas!.width, canvas!.height);
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const i = idx(x, y);
          ctx!.fillStyle = tuxMask[i] ? TUX_FILL : grid[i] ? aliveFill : DEAD_FILL;
          ctx!.fillRect(x * CELL, y * CELL, CELL - GAP, CELL - GAP);
        }
      }
    }

    let last = 0;
    let running = false;
    let raf = 0;
    function loop(now: number) {
      if (!running) return;
      if (now - last >= STEP_MS) {
        step();
        draw();
        last = now;
      }
      raf = requestAnimationFrame(loop);
    }
    const start = () => {
      if (running || reduceMotion) return;
      running = true;
      raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    reset();

    // Browser zoom also fires 'resize' and inflates getBoundingClientRect()'s
    // CSS-px size, which would blow up cols x rows (and the O(cols*rows) sim
    // cost) for no layout reason — devicePixelRatio changes on zoom but not on
    // a real resize, so use it to tell the two apart and skip rebuilding on zoom.
    let lastDPR = window.devicePixelRatio;
    window.addEventListener('resize', () => {
      const dpr = window.devicePixelRatio;
      if (dpr !== lastDPR) {
        lastDPR = dpr;
        return;
      }
      reset();
    });

    // Only animate while the canvas is actually on screen.
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop())).observe(
      canvas,
    );
  }
</script>
