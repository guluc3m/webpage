---
/**
 * Hero — the first screen. Conway's Game of Life runs as the background
 * (GameOfLife is positioned absolutely inside this section's relative box).
 *
 * Shows a random "fortuna" (GUL in-joke) under the slogan. The quote is picked
 * and formatted here, at build time — it changes on each rebuild, not per visit.
 *
 * TODO(design): the actual hero design is still to do. Slogan + fortuna are the
 * real 2021 content; layout/styling is placeholder.
 */
import GameOfLife from './GameOfLife.astro';
import ShaderBackground from './ShaderBackground.astro';
import fortunas from '../../data/fortunas.json';
import { formatFortuna, randomFortuna, type Fortuna } from '../../lib/fortunas.ts';

const fortuna = formatFortuna(randomFortuna(fortunas as Fortuna[]));
---

<section id="inicio" class="relative flex min-h-screen items-center overflow-hidden">
  <ShaderBackground />
  <GameOfLife />
  <div class="relative max-w-3xl px-32 py-8">
    <p class="mb-4 flex items-center gap-3 text-sm font-medium tracking-[0.2em] text-gul-muted uppercase">
      <span class="h-px w-8 bg-gul-line"></span>
      Grupo de Usuarios de Linux
    </p>
    <h1 class="text-5xl font-bold tracking-tight text-gul-ink sm:text-6xl">
      Nos gusta <em class="font-serif font-normal italic">jugar</em> con la tecnología
    </h1>
    <figure class="mt-6 border-l border-gul-line pl-4">
      {/* whitespace-pre-line: the formatter may put a *stage direction* on its own line */}
      <blockquote class="whitespace-pre-line font-serif text-lg text-gul-muted italic">
        {fortuna.quote}
      </blockquote>
      {fortuna.author && <figcaption class="mt-2 text-sm text-gul-muted">{fortuna.author}</figcaption>}
    </figure>
  </div>
</section>
