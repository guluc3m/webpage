---
/**
 * WhatIsGul — "¿Qué es el GUL?" intro section, gallery on the left.
 */
import GulGallery from './gul-Gallery.astro';
import GulTerminal from './gul-Terminal.astro';
---

<section id="que-es-el-gul" class="mx-auto grid max-w-5xl gap-8 p-8 md:grid-cols-2 md:items-center">
  <GulGallery
    id="que-es-el-gul-gallery"
    images={[
      '/real/teclados.jpeg',
      '/real/teclados2.jpeg',
      '/real/tux-coche.jpeg',
      '/real/tux-photofolk.jpeg',
    ]}
  />

  <div>
    <h2 class="text-3xl font-bold text-gul-ink">¿Qué es el GUL?</h2>
    <GulTerminal lines={[{ command: 'whoami' }]} />

    <p class="mt-4 text-gul-muted">
      El <b class="text-gul-ink">Grupo de Usuarios de Linux</b> es una asociación de estudiantes
      unidos por nuestras inquietudes en torno a los ordenadores, la informática y, en concreto, la
      idea común de la utilización y promoción del{' '}
      <a
        href="https://www.gnu.org/philosophy/free-sw.es.html"
        target="_blank"
        rel="noopener"
        class="text-gul-ink underline decoration-gul-line underline-offset-4 hover:decoration-gul-ink"
      >
        <b>software libre</b>
      </a>
      .
    </p>

    <p class="mt-4 text-gul-muted">
      Llevamos{' '}
      <b class="text-gul-ink">
        <span data-years-since="1998">28</span> años
      </b>{' '}
      reuniéndonos cada mes para aprender y compartir conocimientos, normalmente esto se traduce en
      tomar algo todos juntos. Si no estás aquí por la fiesta, también tenemos algunos grupos de
      trabajo enfocados en distintas áreas de la informática y la tecnología, como{' '}
      <b class="text-gul-ink"> Juegos</b> o <b class="text-gul-ink">IA</b>.
    </p>

    <img src="/tux.gif" alt="" width="96" height="96" class="mt-4" />
  </div>
</section>

<script>
  // Computed client-side on purpose, not baked in at build time - otherwise a
  // site that isn't rebuilt every year would freeze on the count from its last build.
  const el = document.querySelector<HTMLElement>('[data-years-since]');
  if (el) {
    const foundedYear = Number(el.dataset.yearsSince);
    el.textContent = String(new Date().getFullYear() - foundedYear);
  }
</script>
