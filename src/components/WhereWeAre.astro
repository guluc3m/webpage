---
/**
 * WhereWeAre — "¿Dónde estamos?" section: the map plus the postal address.
 * Address copied verbatim from the 2021 site.
 */
import Map from './Map.astro';
---

<section id="donde-estamos" class="mx-auto max-w-3xl p-8">
  <h2 class="text-3xl font-bold">¿Dónde estamos?</h2>
  <address class="mt-2 text-neutral-700 not-italic">
    <p>Avenida de la Universidad, 30, 28911 Leganés, Madrid</p>
    <p>Edificio Sabatini</p>
    <p>2.3.C05</p>
  </address>
  <div class="mt-4">
    <Map />
  </div>
</section>
