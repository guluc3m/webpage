---
/**
 * gul-ActividadCard — one entry in the /actividades timeline. With a
 * cartel or photos, the cover image sits beside the frame in a row that stays inside
 * the list's width; the photo is a fixed column and the frame takes the rest.
 * The photo keeps its own aspect ratio, so the two columns rarely match in
 * height — `items-center` lines up their midpoints instead of their tops.
 * Mobile stacks them, photo first. The type and tag badges are buttons that
 * add that filter in gul-ActividadFilters (`data-filter-add`). Clicking the
 * cover opens cartel + photos in gul-Lightbox.
 */
import GulLightbox from './gul-Lightbox.astro';
import GulFrame from './gul-Frame.astro';
import GulBadge from './gul-Badge.astro';
import type { Actividad } from '@/lib/actividades';
import { renderInlineMarkdown } from '@lib/markdown';

interface Props {
  actividad: Actividad;
}

const { actividad: a } = Astro.props;
// The cartel goes first and stays the cover; the photos are what happened after.
const images = [a.poster, ...(a.photos ?? [])]
  .filter((src): src is string => !!src)
  .map((src, i) => ({
    src,
    alt: i === 0 && a.poster ? `Cartel de ${a.title}` : `Foto de ${a.title}`,
  }));
// Has to be a valid, page-unique id; date + title is unique enough in the YAML.
const lightboxId = `actividad-${a.date}-${a.title}`.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// Hand-drawn outline icons (24x24, stroke-based) — matches gul-RepoCard's ICONS, no icon library.
const ICONS = {
  video: '<circle cx="12" cy="12" r="9"/><polygon points="10,8 16,12 10,16"/>',
  repo: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 3v18"/>',
  slides: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M12 16v4M8 20h8"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.2 1.2"/><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2a5 5 0 0 0 7.1 7.1l1.2-1.2"/>',
  stack:
    '<rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/>',
} as const;
// ponytail: los carteles siguen sirviéndose desde public/ sin optimizar. Su
// ruta viene del YAML como cadena, así que <Image> de Astro no encaja sin un
// import.meta.glob; con lazy loading basta mientras la lista sea corta.

// day "00" means "month only" (no exact date yet) — show just month + year.
const hasNoDay = (date: string) => date.endsWith('/00');

const formatDate = (date: string) =>
  hasNoDay(date)
    ? new Date(date.replace('/00', '/01').replaceAll('/', '-')).toLocaleDateString('es-ES', {
        month: 'long',
        year: 'numeric',
      })
    : new Date(date.replaceAll('/', '-')).toLocaleDateString('es-ES', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });

const datetime = hasNoDay(a.date) ? a.date.slice(0, 7) : a.date.replaceAll('/', '-');
---

<div class="flex flex-col gap-4 md:flex-row md:items-center md:gap-6">
  {images.length > 0 && (
    <>
      <button
        type="button"
        data-gul-lightbox-open={lightboxId}
        title={images.length > 1 ? `Ver las ${images.length} imágenes` : 'Ver imagen'}
        class="relative order-first block h-56 w-full cursor-pointer overflow-hidden rounded-md border border-gul-line transition-colors hover:border-gul-ink/40 md:order-last md:h-auto md:w-70 md:shrink-0"
      >
        <img
          src={images[0]!.src}
          alt={images[0]!.alt}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
        {/* Same cue as Instagram's multi-photo posts: there's more behind the click. */}
        {images.length > 1 && (
          <span class="absolute top-2 right-2 inline-flex items-center gap-1 rounded-md bg-gul-bg/80 px-2 py-1 text-xs font-medium text-gul-ink">
            <svg
              viewBox="0 0 24 24"
              class="size-4 shrink-0 stroke-current stroke-[1.5]"
              fill="none"
              set:html={ICONS.stack}
            />
            {images.length}
          </span>
        )}
      </button>
      <GulLightbox id={lightboxId} images={images} />
    </>
  )}
  <div class="min-w-0 flex-1">
    <GulFrame
      surface
      border="border-gul-line transition-colors hover:border-gul-ink/40"
      class="p-4 md:p-8"
      variant="full"
    >
      <time class="text-xs text-gul-muted" datetime={datetime}>
        {formatDate(a.date)}
      </time>
      <h2 class="mt-1">{a.title}</h2>

      {(a.type || (a.tags ?? []).length > 0) && (
        <p class="mt-2 flex flex-wrap items-center gap-1.5">
          <button
            type="button"
            class="group cursor-pointer"
            title={`Filtrar por ${a.type}`}
            data-filter-add="type"
            data-value={a.type}
          >
            <GulBadge variant="primary" class="transition-opacity group-hover:opacity-85">
              {a.type}
            </GulBadge>
          </button>
          {(a.tags ?? []).map((t) => (
            <button
              type="button"
              class="group cursor-pointer"
              title={`Filtrar por ${t}`}
              data-filter-add="tags"
              data-value={t}
            >
              <GulBadge
                variant="secondary"
                class="transition-colors group-hover:border-gul-ink group-hover:text-gul-ink"
              >
                {t}
              </GulBadge>
            </button>
          ))}
        </p>
      )}

      {a.participants && a.participants.length > 0 && (
        <p class="mt-2 text-sm text-gul-muted">
          {a.participants.map((s, i) => (
            <>
              {i > 0 && ', '}
              {s.link ? (
                <a
                  href={s.link}
                  target="_blank"
                  rel="noopener"
                  class="text-gul-ink underline decoration-gul-line underline-offset-4 hover:decoration-gul-ink"
                >
                  {s.name}
                </a>
              ) : (
                s.name
              )}
            </>
          ))}
        </p>
      )}

      {a.description && (
        <p class="mt-1 text-sm text-gul-muted" set:html={renderInlineMarkdown(a.description)} />
      )}

      {(a.video || a.source || a.slides || a.link) && (
        <p class="mt-3 flex flex-wrap items-center gap-2 text-sm">
          {[
            { href: a.video, label: 'Vídeo', icon: ICONS.video },
            { href: a.source, label: 'Repositorio', icon: ICONS.repo },
            { href: a.slides, label: 'Transparencias', icon: ICONS.slides },
            { href: a.link, label: 'Link', icon: ICONS.link },
          ]
            .filter((link) => link.href)
            .map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full bg-gul-line px-3.5 py-1.5 font-medium text-gul-ink transition-opacity hover:opacity-85"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 shrink-0 stroke-current stroke-[1.5]"
                  fill="none"
                  set:html={link.icon}
                />
                {link.label}
              </a>
            ))}
        </p>
      )}
    </GulFrame>
  </div>
</div>
