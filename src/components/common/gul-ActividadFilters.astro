---
/**
 * gul-ActividadFilters — columna de filtros de /actividades: búsqueda por
 * título, tema o persona, tipo de actividad (abierto por defecto), tags
 * (las más usadas, el resto tras "Ver todas") y participantes (buscador +
 * las más frecuentes) en chips multi-selección, y fecha por rango de cursos
 * + cuatrimestre. Cada chip dice cuántas actividades daría. En md+ es una
 * columna lateral sticky; en móvil se pliega tras el botón "Filtros" (CSS
 * puro guiado por aria-expanded). Cada grupo es un <details> colapsado por
 * defecto (salvo Tipo, que va abierto) con contador de seleccionados y un
 * "Limpiar" que vacía solo ese grupo.
 *
 * El script hace el filtrado client-side: consulta los <li data-actividad>
 * y el contador/vacío del listado, que viven en la página (un solo uso,
 * junto a este componente). Las opciones llegan ya calculadas como props.
 */
import filterIcon from '@icons/ui/filter.svg?url';
import searchIcon from '@icons/ui/search.svg?url';

interface Props {
  /** Tipos de actividad (`type`), en orden fijo. */
  types: string[];
  /** Más usadas primero: las TOP_TAGS primeras se ven sin desplegar. */
  tags: string[];
  participants: string[];
  /** Cursos (años de inicio, p.ej. 2025 para 2025/26), más nuevo primero. */
  cursos: number[];
}

const { types, tags, participants, cursos } = Astro.props;
const minCurso = Math.min(...cursos);
const maxCurso = Math.max(...cursos);
const cursoLabel = (curso: number) => `${curso}/${String(curso + 1).slice(2)}`;

// Con 80+ etiquetas, la mitad usadas una sola vez, verlas todas de golpe
// esconde las importantes; el resto queda tras "Ver todas".
const TOP_TAGS = 12;

// Cuatrimestres dentro de un curso: el 1.º va de sep a ene y el 2.º de feb a
// ago (febrero es ya segundo cuatrimestre en la UC3M).
const semesters = [
  { value: 'c1', label: '1.º · Sep–Ene' },
  { value: 'c2', label: '2.º · Feb–Ago' },
];
---

<div class="md:sticky md:top-20 md:flex md:max-h-[calc(100svh-6rem)] md:flex-col md:self-start">
  <div class="relative">
    <img
      src={searchIcon}
      alt=""
      class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 invert"
    />
    <input type="search" placeholder="Título, tema o persona…" data-filter-search class="pl-9" />
  </div>

  <button
    type="button"
    class="mt-3 flex w-full items-center justify-between rounded-md border border-gul-line px-3 py-2 text-sm font-semibold text-gul-ink hover:border-gul-ink md:hidden"
    data-filters-toggle
    aria-expanded="false"
    aria-controls="gul-actividad-filters-panel"
  >
    <span class="flex items-center gap-2">
      <img src={filterIcon} alt="" class="size-4 invert" />
      Filtros
      <span
        class="hidden rounded-full bg-gul-blue px-2 py-0.5 text-xs font-semibold"
        data-filters-badge
        hidden
      ></span>
    </span>
    <span class="text-gul-muted transition-transform" data-filters-chevron aria-hidden="true">
      ▾
    </span>
  </button>

  <aside
    id="gul-actividad-filters-panel"
    class="gul-filters-panel mt-3 rounded-md border border-gul-line bg-gul-surface p-4 md:min-h-0 md:overflow-y-auto"
    data-filters-panel
  >
    <details open data-filter-group>
      <summary class="py-3">
        <span class="flex items-center gap-2">
          Tipo
          <span
            class="rounded-full bg-gul-blue px-2 py-0.5 text-xs font-semibold"
            data-group-count="type"
            hidden
          ></span>
        </span>
      </summary>
      <div>
        <div class="pb-4">
          <div class="flex flex-wrap gap-1.5" data-chip-group="type">
            {types.map((t) => (
              <button
                type="button"
                class="gul-chip"
                data-chip="type"
                data-value={t}
                aria-pressed="false"
              >
                {t}
                <span class="gul-chip-count" data-chip-count></span>
              </button>
            ))}
          </div>
          <div class="pt-2">
            <button type="button" class="gul-mini" data-clear-group="type">
              Limpiar
            </button>
          </div>
        </div>
      </div>
    </details>

    <details data-filter-group>
      <summary class="py-3">
        <span class="flex items-center gap-2">
          Etiquetas
          <span
            class="rounded-full bg-gul-blue px-2 py-0.5 text-xs font-semibold"
            data-group-count="tags"
            hidden
          ></span>
        </span>
      </summary>
      <div>
        <div class="pb-4">
          <div
            id="gul-tags-chips"
            class="flex flex-wrap gap-1.5"
            data-chip-group="tags"
            data-collapsed
          >
            {tags.map((t, i) => (
              <button
                type="button"
                class="gul-chip"
                data-chip="tags"
                data-value={t}
                data-overflow={i >= TOP_TAGS ? '' : undefined}
                aria-pressed="false"
              >
                {t}
                <span class="gul-chip-count" data-chip-count></span>
              </button>
            ))}
          </div>
          <div class="flex justify-between pt-2">
            <button type="button" class="gul-mini" data-clear-group="tags">
              Limpiar
            </button>
            {tags.length > TOP_TAGS && (
              <button
                type="button"
                class="gul-mini"
                aria-expanded="false"
                aria-controls="gul-tags-chips"
                data-tags-more
              >
                Ver todas ({tags.length})
              </button>
            )}
          </div>
        </div>
      </div>
    </details>

    <details data-filter-group>
      <summary class="py-3">
        <span class="flex items-center gap-2">
          Fecha
          <span
            class="rounded-full bg-gul-blue px-2 py-0.5 text-xs font-semibold"
            data-group-count="fecha"
            hidden
          ></span>
        </span>
      </summary>
      <div>
        <div class="pb-4">
          <div class="space-y-3">
            {/* Un chip por curso ya no cabe (son 25+). Dos <input type="range">
                superpuestos hacen de slider con dos tiradores: nativo, y se
                maneja también con las flechas del teclado. */}
            <div data-curso-range-box style={`--a: 0; --b: 1`}>
              <p class="flex justify-between pb-1.5 text-xs tracking-wider text-gul-muted uppercase">
                <span>Curso</span>
                <span class="tracking-normal text-gul-ink normal-case" data-curso-range-label>
                  {cursoLabel(minCurso)} – {cursoLabel(maxCurso)}
                </span>
              </p>
              <div class="gul-range relative h-5">
                <div class="absolute inset-x-0 top-1/2 h-1 -translate-y-1/2 rounded-full bg-gul-line" />
                <div class="gul-range-fill absolute top-1/2 h-1 -translate-y-1/2 rounded-full bg-gul-blue" />
                {(['from', 'to'] as const).map((bound) => (
                  <input
                    type="range"
                    min={minCurso}
                    max={maxCurso}
                    step="1"
                    value={bound === 'from' ? minCurso : maxCurso}
                    aria-label={bound === 'from' ? 'Desde el curso' : 'Hasta el curso'}
                    data-curso-range={bound}
                  />
                ))}
              </div>
            </div>
            <div>
              <p class="pb-1.5 text-xs tracking-wider text-gul-muted uppercase">Cuatrimestre</p>
              <div class="flex flex-wrap gap-1.5" data-chip-group="semesters">
                {semesters.map((s) => (
                  <button
                    type="button"
                    class="gul-chip"
                    data-chip="semesters"
                    data-value={s.value}
                    aria-pressed="false"
                  >
                    {s.label}
                    <span class="gul-chip-count" data-chip-count></span>
                  </button>
                ))}
              </div>
            </div>
          </div>
          <div class="pt-2">
            <button type="button" class="gul-mini" data-clear-group="fecha">
              Limpiar
            </button>
          </div>
        </div>
      </div>
    </details>

    <details data-filter-group>
      <summary class="py-3">
        <span class="flex items-center gap-2">
          Participantes
          <span
            class="rounded-full bg-gul-blue px-2 py-0.5 text-xs font-semibold"
            data-group-count="participants"
            hidden
          ></span>
        </span>
      </summary>
      <div>
        <div class="pb-4">
          {/* 100+ personas, la mayoría con una sola actividad: a alguien se le
              busca por el nombre, así que solo se ven las elegidas y unas
              pocas sugerencias (las más frecuentes, o las que coinciden). */}
          <input
            type="search"
            placeholder="Buscar persona…"
            aria-label="Buscar persona"
            aria-controls="gul-people-chips"
            class="mb-2 px-2 py-1 text-sm"
            data-people-search
          />
          <div id="gul-people-chips" class="flex flex-wrap gap-1.5" data-chip-group="participants">
            {participants.map((s) => (
              <button
                type="button"
                class="gul-chip"
                data-chip="participants"
                data-value={s}
                aria-pressed="false"
              >
                {s}
                <span class="gul-chip-count" data-chip-count></span>
              </button>
            ))}
          </div>
          <p class="pt-1.5 text-xs text-gul-muted" aria-live="polite" data-people-more hidden></p>
          <div class="pt-2">
            <button type="button" class="gul-mini" data-clear-group="participants">
              Limpiar
            </button>
          </div>
        </div>
      </div>
    </details>

    <button type="button" class="gul-mini mt-3" data-filters-clear disabled>
      Limpiar filtros
    </button>
  </aside>
</div>

<style>
  /* Panel de filtros: plegado en móvil tras el botón "Filtros"; en md+ la
     columna lateral siempre visible (sticky sobre el header fijo). Una
     columna sticky más alta que la pantalla deja su final inalcanzable, así
     que en md+ se limita al alto visible y el panel hace scroll por dentro. */
  .gul-filters-panel {
    display: none;
  }
  [data-filters-toggle][aria-expanded='true'] + .gul-filters-panel {
    display: block;
  }
  @media (min-width: 48rem) {
    .gul-filters-panel {
      display: block !important;
      /* Sin color-scheme en la página, el scrollbar por defecto sale claro. */
      scrollbar-width: thin;
      scrollbar-color: var(--color-gul-line) transparent;
    }
  }
  [data-filters-toggle][aria-expanded='true'] [data-filters-chevron] {
    transform: rotate(180deg);
  }

  /* El accordion global (Faq) quita el borde inferior de los details abiertos;
     aquí los separadores entre grupos ayudan a leer el panel, así que los
     mantenemos también en abierto. */
  .gul-filters-panel details,
  .gul-filters-panel details[open] {
    border-bottom-color: var(--color-gul-line);
  }

  /* Chip de filtro multi-selección. Seleccionado: borde azul + check, el
     acento primario del sitio (mismo criterio que gul-Button primary). */
  .gul-chip {
    border-radius: 9999px;
    border: 1px solid var(--color-gul-line);
    padding-inline: 0.625rem;
    padding-block: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-gul-muted);
    cursor: pointer;
    transition:
      color 0.1s ease,
      border-color 0.1s ease,
      background-color 0.1s ease;
  }
  .gul-chip:hover {
    border-color: var(--color-gul-ink);
    color: var(--color-gul-ink);
  }
  .gul-chip[aria-pressed='true'] {
    border-color: var(--color-gul-blue);
    background-color: color-mix(in oklab, var(--color-gul-blue) 20%, transparent);
    color: var(--color-gul-ink);
  }
  .gul-chip-count {
    margin-left: 0.375rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }
  /* Elegirla dejaría la lista vacía: se atenúa pero sigue pulsable. */
  .gul-chip[data-empty]:not([aria-pressed='true']) {
    opacity: 0.4;
  }
  .gul-chip[aria-pressed='true']::before {
    content: '✓ ';
    color: var(--color-gul-blue);
  }

  /* Etiquetas recogidas: fuera de las más usadas solo se ven las elegidas,
     para que una selección no desaparezca al recoger la lista. */
  [data-collapsed] > [data-overflow]:not([aria-pressed='true']) {
    display: none;
  }

  /* Slider de cursos: dos inputs range apilados con el carril vacío. Solo los
     tiradores reciben el ratón, así cada uno se arrastra aunque el otro input
     esté encima. --a/--b (0–1) son los extremos que pone el script; el relleno
     descuenta medio tirador a cada lado para empezar y acabar en su centro. */
  .gul-range {
    --thumb: 1rem;
  }
  .gul-range input {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    appearance: none;
    pointer-events: none;
  }
  .gul-range input::-webkit-slider-thumb {
    appearance: none;
    width: var(--thumb);
    height: var(--thumb);
    border-radius: 9999px;
    border: 2px solid var(--color-gul-surface);
    background: var(--color-gul-ink);
    cursor: grab;
    pointer-events: auto;
  }
  .gul-range input::-moz-range-thumb {
    width: var(--thumb);
    height: var(--thumb);
    border-radius: 9999px;
    border: 2px solid var(--color-gul-surface);
    background: var(--color-gul-ink);
    cursor: grab;
    pointer-events: auto;
  }
  .gul-range input::-moz-range-track {
    background: transparent;
  }
  .gul-range input:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--color-gul-blue);
  }
  .gul-range input:focus-visible::-moz-range-thumb {
    outline: 2px solid var(--color-gul-blue);
  }
  .gul-range-fill {
    left: calc(var(--thumb) / 2 + (100% - var(--thumb)) * var(--a));
    right: calc(var(--thumb) / 2 + (100% - var(--thumb)) * (1 - var(--b)));
  }

  /* Botoncito de texto (limpiar). */
  .gul-mini {
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-gul-blue);
    cursor: pointer;
  }
  .gul-mini:hover:not(:disabled) {
    text-decoration: underline;
  }
  .gul-mini:disabled {
    color: var(--color-gul-line);
    cursor: default;
  }
</style>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-filter-search]')!;
  const panel = document.querySelector<HTMLElement>('[data-filters-panel]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-filters-toggle]')!;
  // El listado (items, marcadores de curso, contador y estado vacío) pinta en
  // la página; este componente solo lo filtra.
  const items = document.querySelectorAll<HTMLLIElement>('[data-actividad]');
  const cursoMarkers = document.querySelectorAll<HTMLLIElement>('[data-curso-marker]');
  const empty = document.querySelector<HTMLElement>('[data-actividades-empty]')!;
  const countLine = document.querySelector<HTMLElement>('[data-actividades-count]')!;

  type Group = 'type' | 'tags' | 'participants' | 'semesters';
  const groups: Group[] = ['type', 'tags', 'participants', 'semesters'];
  const selected: Record<Group, Set<string>> = {
    type: new Set(),
    tags: new Set(),
    participants: new Set(),
    semesters: new Set(),
  };

  // Rango de cursos. Los tiradores se pueden cruzar: el rango es siempre del
  // menor al mayor, así que da igual cuál se arrastre.
  const rangeBox = panel.querySelector<HTMLElement>('[data-curso-range-box]')!;
  const rangeLabel = panel.querySelector<HTMLElement>('[data-curso-range-label]')!;
  const cursoFrom = panel.querySelector<HTMLInputElement>('[data-curso-range="from"]')!;
  const cursoTo = panel.querySelector<HTMLInputElement>('[data-curso-range="to"]')!;
  const minCurso = Number(cursoFrom.min);
  const maxCurso = Number(cursoFrom.max);
  const cursoLow = () => Math.min(cursoFrom.valueAsNumber, cursoTo.valueAsNumber);
  const cursoHigh = () => Math.max(cursoFrom.valueAsNumber, cursoTo.valueAsNumber);
  const rangeActive = () => cursoLow() > minCurso || cursoHigh() < maxCurso;
  const inCursoRange = (curso: number) => curso >= cursoLow() && curso <= cursoHigh();
  const cursoLabel = (curso: number) => `${curso}/${String(curso + 1).slice(2)}`;
  function clearCursoRange() {
    cursoFrom.value = String(minCurso);
    cursoTo.value = String(maxCurso);
  }
  function syncCursoRange() {
    const span = maxCurso - minCurso || 1;
    rangeBox.style.setProperty('--a', String((cursoLow() - minCurso) / span));
    rangeBox.style.setProperty('--b', String((cursoHigh() - minCurso) / span));
    rangeLabel.textContent =
      cursoLow() === cursoHigh()
        ? cursoLabel(cursoLow())
        : `${cursoLabel(cursoLow())} – ${cursoLabel(cursoHigh())}`;
  }

  // El badge del grupo Fecha cuenta el rango (como uno) + los cuatrimestres.
  const fechaBadge = () => Number(rangeActive()) + selected.semesters.size;

  // Cuatrimestre desde la fecha yyyy-mm-dd del item: sep–ene → c1, feb–ago → c2.
  const semesterOf = (date: string) => {
    const month = Number(date.slice(5, 7));
    return month >= 9 || month <= 1 ? 'c1' : 'c2';
  };

  // Los items guardan data-tags/participants en minúsculas (ver el HTML);
  // normalizar aquí para que el estado coincida sea cual sea la capitalización.
  const norm = (s: string) => s.toLowerCase();
  // La búsqueda ignora tildes: "jesus" encuentra a "Jesús".
  const fold = (s: string) =>
    s
      .normalize('NFD')
      .replace(/\p{Diacritic}/gu, '')
      .toLowerCase();
  const searchText = new Map(
    [...items].map((item) => [
      item,
      fold([item.dataset.title, item.dataset.tags, item.dataset.participants].join(' ')),
    ]),
  );

  function setGroup(group: Group, values: Set<string>) {
    selected[group] = values;
    panel.querySelectorAll<HTMLButtonElement>(`[data-chip="${group}"]`).forEach((chip) => {
      chip.setAttribute('aria-pressed', String(values.has(norm(chip.dataset.value!))));
    });
  }

  function syncControls() {
    panel.querySelectorAll<HTMLElement>('[data-group-count]').forEach((badge) => {
      const group = badge.dataset.groupCount!;
      const n = group === 'fecha' ? fechaBadge() : selected[group as Group].size;
      badge.textContent = String(n);
      badge.hidden = n === 0;
    });

    syncCursoRange();
    const total = groups.reduce((n, g) => n + selected[g].size, 0) + Number(rangeActive());
    const toggleBadge = document.querySelector<HTMLElement>('[data-filters-badge]')!;
    toggleBadge.textContent = String(total);
    toggleBadge.hidden = total === 0;
    // Algo que limpiar hay con chips activos o con búsqueda escrita.
    const canClear = total > 0 || search.value.trim() !== '';
    document
      .querySelectorAll<HTMLButtonElement>('[data-filters-clear]')
      .forEach((b) => (b.disabled = !canClear));
  }

  // Valores de un item en cada grupo (la página los guarda en minúsculas).
  const list = (s: string) => (s ? s.split(',') : []);
  const valuesOf: Record<Group, (item: HTMLElement) => string[]> = {
    type: (item) => [item.dataset.type!],
    tags: (item) => list(item.dataset.tags!),
    participants: (item) => list(item.dataset.participants!),
    semesters: (item) => [semesterOf(item.dataset.date!)],
  };
  // Dentro de un grupo las opciones suman (OR); un grupo vacío no filtra.
  const passesGroup = (item: HTMLElement, g: Group) =>
    selected[g].size === 0 || valuesOf[g](item).some((v) => selected[g].has(v));

  const TOP_PEOPLE = 8;
  const peopleSearch = panel.querySelector<HTMLInputElement>('[data-people-search]')!;
  const peopleBox = panel.querySelector<HTMLElement>('[data-chip-group="participants"]')!;
  const peopleMore = panel.querySelector<HTMLElement>('[data-people-more]')!;
  // Elegidas siempre visibles y primero; detrás, hasta TOP_PEOPLE sugerencias:
  // sin búsqueda, las que más actividades dan ahora; buscando, las que
  // coinciden (también las que darían 0, para ver que existen). Se ordena con
  // `order` y no moviendo nodos, que haría perder el foco al chip pulsado.
  function syncPeople(counts: Map<string, number>) {
    const q = fold(peopleSearch.value.trim());
    const n = (c: HTMLElement) => counts.get(norm(c.dataset.value!)) ?? 0;
    const on = (c: HTMLElement) => c.getAttribute('aria-pressed') === 'true';
    const chips = [...peopleBox.querySelectorAll<HTMLButtonElement>('[data-chip]')].sort(
      (a, b) =>
        Number(on(b)) - Number(on(a)) ||
        n(b) - n(a) ||
        a.dataset.value!.localeCompare(b.dataset.value!, 'es'),
    );
    let suggested = 0;
    let rest = 0;
    chips.forEach((c, i) => {
      c.style.order = String(i);
      const candidate = !on(c) && (q ? fold(c.dataset.value!).includes(q) : n(c) > 0);
      const show = on(c) || (candidate && suggested < TOP_PEOPLE);
      if (candidate) {
        if (show) suggested++;
        else rest++;
      }
      c.hidden = !show;
    });
    peopleMore.hidden = rest === 0 && !(q && suggested === 0);
    peopleMore.textContent =
      q && suggested === 0
        ? 'Nadie con ese nombre.'
        : q
          ? `y ${rest} más, afina la búsqueda`
          : `y ${rest} más, búscalas por nombre`;
  }

  function applyFilters() {
    const q = fold(search.value.trim());
    let visible = 0;
    const visibleCursos = new Set<string>();
    // Lo que muestra cada chip: cuántas actividades saldrían eligiéndolo, o
    // sea, las que tienen ese valor y pasan todos los filtros salvo los de su
    // propio grupo.
    const counts = Object.fromEntries(groups.map((g) => [g, new Map<string, number>()])) as Record<
      Group,
      Map<string, number>
    >;

    items.forEach((item) => {
      const base = searchText.get(item)!.includes(q) && inCursoRange(Number(item.dataset.curso));
      const failed = base ? groups.filter((g) => !passesGroup(item, g)) : groups;
      const matches = base && failed.length === 0;
      if (base) {
        for (const g of groups) {
          if (failed.length > 1 || (failed.length === 1 && failed[0] !== g)) continue;
          for (const v of valuesOf[g](item)) counts[g].set(v, (counts[g].get(v) ?? 0) + 1);
        }
      }
      item.hidden = !matches;
      if (matches) {
        visible++;
        visibleCursos.add(item.dataset.curso!);
      }
    });

    panel.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((chip) => {
      const n = counts[chip.dataset.chip as Group].get(norm(chip.dataset.value!)) ?? 0;
      chip.querySelector('[data-chip-count]')!.textContent = String(n);
      chip.toggleAttribute('data-empty', n === 0);
    });
    syncPeople(counts.participants);

    // A curso with no activities yet (the current one) always shows; one with activities
    // hides once the filter matches none of them.
    cursoMarkers.forEach((marker) => {
      const hasActividades = marker.dataset.cursoCount !== '0';
      marker.hidden = hasActividades && !visibleCursos.has(marker.dataset.cursoMarker!);
    });

    empty.hidden = visible > 0;
    countLine.textContent = `${visible} ${visible === 1 ? 'actividad' : 'actividades'}`;
    syncControls();
  }

  // Delegación a nivel document: el "Limpiar filtros" del estado vacío vive
  // fuera del panel, y así un solo listener cubre todos los controles.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const chip = target.closest<HTMLButtonElement>('[data-chip]');
    if (chip) {
      const group = chip.dataset.chip as Group;
      const value = norm(chip.dataset.value!);
      const next = new Set(selected[group]);
      if (next.has(value)) next.delete(value);
      else next.add(value);
      setGroup(group, next);
      applyFilters();
      return;
    }

    // Etiqueta o tipo pulsado en una tarjeta: añade ese filtro (no lo quita si
    // ya estaba) y sube al principio del listado, que acaba de cambiar entero.
    const add = target.closest<HTMLButtonElement>('[data-filter-add]');
    if (add) {
      const group = add.dataset.filterAdd as Group;
      setGroup(group, new Set(selected[group]).add(norm(add.dataset.value!)));
      applyFilters();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      countLine.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
      return;
    }

    const clearGroup = target.closest<HTMLButtonElement>('[data-clear-group]');
    if (clearGroup) {
      const group = clearGroup.dataset.clearGroup;
      // El grupo Fecha cuenta curso y cuatrimestre juntos; los limpia a la vez.
      if (group === 'fecha') {
        clearCursoRange();
        setGroup('semesters', new Set());
      } else {
        setGroup(group as Group, new Set());
        if (group === 'participants') peopleSearch.value = '';
      }
      applyFilters();
      return;
    }

    const more = target.closest<HTMLButtonElement>('[data-tags-more]');
    if (more) {
      const chips = document.getElementById(more.getAttribute('aria-controls')!)!;
      const expand = more.getAttribute('aria-expanded') !== 'true';
      chips.toggleAttribute('data-collapsed', !expand);
      more.setAttribute('aria-expanded', String(expand));
      more.textContent = expand ? 'Ver menos' : `Ver todas (${chips.children.length})`;
      return;
    }

    if (target.closest('[data-filters-clear]')) {
      search.value = '';
      peopleSearch.value = '';
      clearCursoRange();
      groups.forEach((g) => setGroup(g, new Set()));
      applyFilters();
    }
  });

  search.addEventListener('input', applyFilters);
  peopleSearch.addEventListener('input', applyFilters);
  cursoFrom.addEventListener('input', applyFilters);
  cursoTo.addEventListener('input', applyFilters);

  toggle.addEventListener('click', () => {
    toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
  });

  applyFilters();
</script>
