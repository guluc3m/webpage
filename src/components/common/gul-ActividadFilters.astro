---
/**
 * gul-ActividadFilters — columna de filtros de /actividades: búsqueda por
 * título, tags y participantes multi-selección (chips), y fecha por curso +
 * cuatrimestre. En md+ es una columna lateral sticky; en móvil se pliega
 * tras el botón "Filtros" (CSS puro guiado por aria-expanded). Cada grupo es
 * un <details> colapsado por defecto, con contador de seleccionados y un
 * "Limpiar" que vacía solo ese grupo.
 *
 * El script hace el filtrado client-side: consulta los <li data-actividad>
 * y el contador/vacío del listado, que viven en la página (un solo uso,
 * junto a este componente). Las opciones llegan ya calculadas como props.
 */
import filterIcon from '@icons/ui/filter.svg?url';
import searchIcon from '@icons/ui/search.svg?url';

interface Props {
  tags: string[];
  participants: string[];
  /** Cursos (años de inicio, p.ej. 2025 para 2025/26), más nuevo primero. */
  cursos: number[];
}

const { tags, participants, cursos } = Astro.props;

// Cuatrimestres dentro de un curso: el 1.º va de sep a ene y el 2.º de feb a
// ago (febrero es ya segundo cuatrimestre en la UC3M).
const semesters = [
  { value: 'c1', label: '1.º · Sep–Ene' },
  { value: 'c2', label: '2.º · Feb–Ago' },
];
---

<div class="md:sticky md:top-20 md:self-start">
  <div class="relative">
    <img
      src={searchIcon}
      alt=""
      class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 invert"
    />
    <input type="search" placeholder="Buscar por título…" data-filter-search class="pl-9" />
  </div>

  <button
    type="button"
    class="mt-3 flex w-full items-center justify-between rounded-md border border-gul-line px-3 py-2 text-sm font-semibold text-gul-ink hover:border-gul-ink md:hidden"
    data-filters-toggle
    aria-expanded="false"
    aria-controls="gul-actividad-filters-panel"
  >
    <span class="flex items-center gap-2">
      <img src={filterIcon} alt="" class="size-4 invert" />
      Filtros
      <span
        class="hidden rounded-full bg-gul-blue px-2 py-0.5 text-xs font-semibold"
        data-filters-badge
        hidden
      ></span>
    </span>
    <span class="text-gul-muted transition-transform" data-filters-chevron aria-hidden="true">
      ▾
    </span>
  </button>

  <aside
    id="gul-actividad-filters-panel"
    class="gul-filters-panel mt-3 rounded-md border border-gul-line bg-gul-surface p-4"
    data-filters-panel
  >
    <details data-filter-group>
      <summary class="py-3">
        <span class="flex items-center gap-2">
          Etiquetas
          <span
            class="rounded-full bg-gul-blue px-2 py-0.5 text-xs font-semibold"
            data-group-count="tags"
            hidden
          ></span>
        </span>
      </summary>
      <div>
        <div class="pb-4">
          <div class="flex flex-wrap gap-1.5" data-chip-group="tags">
            {tags.map((t) => (
              <button
                type="button"
                class="gul-chip"
                data-chip="tags"
                data-value={t}
                aria-pressed="false"
              >
                {t}
              </button>
            ))}
          </div>
          <div class="pt-2">
            <button type="button" class="gul-mini" data-clear-group="tags">
              Limpiar
            </button>
          </div>
        </div>
      </div>
    </details>

    <details data-filter-group>
      <summary class="py-3">
        <span class="flex items-center gap-2">
          Participantes
          <span
            class="rounded-full bg-gul-blue px-2 py-0.5 text-xs font-semibold"
            data-group-count="participants"
            hidden
          ></span>
        </span>
      </summary>
      <div>
        <div class="pb-4">
          <div class="flex flex-wrap gap-1.5" data-chip-group="participants">
            {participants.map((s) => (
              <button
                type="button"
                class="gul-chip"
                data-chip="participants"
                data-value={s}
                aria-pressed="false"
              >
                {s}
              </button>
            ))}
          </div>
          <div class="pt-2">
            <button type="button" class="gul-mini" data-clear-group="participants">
              Limpiar
            </button>
          </div>
        </div>
      </div>
    </details>

    <details data-filter-group>
      <summary class="py-3">
        <span class="flex items-center gap-2">
          Fecha
          <span
            class="rounded-full bg-gul-blue px-2 py-0.5 text-xs font-semibold"
            data-group-count="fecha"
            hidden
          ></span>
        </span>
      </summary>
      <div>
        <div class="pb-4">
          <div class="space-y-3">
            <div>
              <p class="pb-1.5 text-xs tracking-wider text-gul-muted uppercase">Curso</p>
              <div class="flex flex-wrap gap-1.5" data-chip-group="cursos">
                {cursos.map((curso) => (
                  <button
                    type="button"
                    class="gul-chip"
                    data-chip="cursos"
                    data-value={String(curso)}
                    aria-pressed="false"
                  >
                    {curso}/{String(curso + 1).slice(2)}
                  </button>
                ))}
              </div>
            </div>
            <div>
              <p class="pb-1.5 text-xs tracking-wider text-gul-muted uppercase">Cuatrimestre</p>
              <div class="flex flex-wrap gap-1.5" data-chip-group="semesters">
                {semesters.map((s) => (
                  <button
                    type="button"
                    class="gul-chip"
                    data-chip="semesters"
                    data-value={s.value}
                    aria-pressed="false"
                  >
                    {s.label}
                  </button>
                ))}
              </div>
            </div>
          </div>
          <div class="pt-2">
            <button type="button" class="gul-mini" data-clear-group="fecha">
              Limpiar
            </button>
          </div>
        </div>
      </div>
    </details>

    <button type="button" class="gul-mini mt-3" data-filters-clear disabled>
      Limpiar filtros
    </button>
  </aside>
</div>

<style>
  /* Panel de filtros: plegado en móvil tras el botón "Filtros"; en md+ la
     columna lateral siempre visible (sticky sobre el header fijo). */
  .gul-filters-panel {
    display: none;
  }
  [data-filters-toggle][aria-expanded='true'] + .gul-filters-panel {
    display: block;
  }
  @media (min-width: 48rem) {
    .gul-filters-panel {
      display: block !important;
    }
  }
  [data-filters-toggle][aria-expanded='true'] [data-filters-chevron] {
    transform: rotate(180deg);
  }

  /* El accordion global (Faq) quita el borde inferior de los details abiertos;
     aquí los separadores entre grupos ayudan a leer el panel, así que los
     mantenemos también en abierto. */
  .gul-filters-panel details,
  .gul-filters-panel details[open] {
    border-bottom-color: var(--color-gul-line);
  }

  /* Chip de filtro multi-selección. Seleccionado: borde azul + check, el
     acento primario del sitio (mismo criterio que gul-Button primary). */
  .gul-chip {
    border-radius: 9999px;
    border: 1px solid var(--color-gul-line);
    padding-inline: 0.625rem;
    padding-block: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-gul-muted);
    cursor: pointer;
    transition:
      color 0.1s ease,
      border-color 0.1s ease,
      background-color 0.1s ease;
  }
  .gul-chip:hover {
    border-color: var(--color-gul-ink);
    color: var(--color-gul-ink);
  }
  .gul-chip[aria-pressed='true'] {
    border-color: var(--color-gul-blue);
    background-color: color-mix(in oklab, var(--color-gul-blue) 20%, transparent);
    color: var(--color-gul-ink);
  }
  .gul-chip[aria-pressed='true']::before {
    content: '✓ ';
    color: var(--color-gul-blue);
  }

  /* Botoncito de texto (limpiar). */
  .gul-mini {
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-gul-blue);
    cursor: pointer;
  }
  .gul-mini:hover:not(:disabled) {
    text-decoration: underline;
  }
  .gul-mini:disabled {
    color: var(--color-gul-line);
    cursor: default;
  }
</style>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-filter-search]')!;
  const panel = document.querySelector<HTMLElement>('[data-filters-panel]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-filters-toggle]')!;
  // El listado (items, marcadores de curso, contador y estado vacío) pinta en
  // la página; este componente solo lo filtra.
  const items = document.querySelectorAll<HTMLLIElement>('[data-actividad]');
  const cursoMarkers = document.querySelectorAll<HTMLLIElement>('[data-curso-marker]');
  const empty = document.querySelector<HTMLElement>('[data-actividades-empty]')!;
  const countLine = document.querySelector<HTMLElement>('[data-actividades-count]')!;

  type Group = 'tags' | 'participants' | 'cursos' | 'semesters';
  const groups: Group[] = ['tags', 'participants', 'cursos', 'semesters'];
  const selected: Record<Group, Set<string>> = {
    tags: new Set(),
    participants: new Set(),
    cursos: new Set(),
    semesters: new Set(),
  };

  // El badge del grupo Fecha cuenta curso + cuatrimestre juntos.
  const fechaBadge = () => selected.cursos.size + selected.semesters.size;

  // Cuatrimestre desde la fecha yyyy-mm-dd del item: sep–ene → c1, feb–ago → c2.
  const semesterOf = (date: string) => {
    const month = Number(date.slice(5, 7));
    return month >= 9 || month <= 1 ? 'c1' : 'c2';
  };

  // Los items guardan data-tags/participants en minúsculas (ver el HTML);
  // normalizar aquí para que el estado coincida sea cual sea la capitalización.
  const norm = (s: string) => s.toLowerCase();

  function setGroup(group: Group, values: Set<string>) {
    selected[group] = values;
    panel.querySelectorAll<HTMLButtonElement>(`[data-chip="${group}"]`).forEach((chip) => {
      chip.setAttribute('aria-pressed', String(values.has(norm(chip.dataset.value!))));
    });
  }

  function syncControls() {
    panel.querySelectorAll<HTMLElement>('[data-group-count]').forEach((badge) => {
      const group = badge.dataset.groupCount!;
      const n = group === 'fecha' ? fechaBadge() : selected[group as Group].size;
      badge.textContent = String(n);
      badge.hidden = n === 0;
    });

    const total = groups.reduce((n, g) => n + selected[g].size, 0);
    const toggleBadge = document.querySelector<HTMLElement>('[data-filters-badge]')!;
    toggleBadge.textContent = String(total);
    toggleBadge.hidden = total === 0;
    // Algo que limpiar hay con chips activos o con búsqueda escrita.
    const canClear = total > 0 || search.value.trim() !== '';
    document
      .querySelectorAll<HTMLButtonElement>('[data-filters-clear]')
      .forEach((b) => (b.disabled = !canClear));
  }

  function applyFilters() {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    const visibleCursos = new Set<string>();

    items.forEach((item) => {
      const date = item.dataset.date!;
      const matches =
        item.dataset.title!.includes(q) &&
        (selected.tags.size === 0 ||
          item.dataset.tags!.split(',').some((t) => selected.tags.has(t))) &&
        (selected.participants.size === 0 ||
          item.dataset.participants!.split(',').some((p) => selected.participants.has(p))) &&
        (selected.cursos.size === 0 || selected.cursos.has(item.dataset.curso!)) &&
        (selected.semesters.size === 0 || selected.semesters.has(semesterOf(date)));
      item.hidden = !matches;
      if (matches) {
        visible++;
        visibleCursos.add(item.dataset.curso!);
      }
    });

    // A curso with no activities yet (the current one) always shows; one with activities
    // hides once the filter matches none of them.
    cursoMarkers.forEach((marker) => {
      const hasActividades = marker.dataset.cursoCount !== '0';
      marker.hidden = hasActividades && !visibleCursos.has(marker.dataset.cursoMarker!);
    });

    empty.hidden = visible > 0;
    countLine.textContent = `${visible} ${visible === 1 ? 'actividad' : 'actividades'}`;
    syncControls();
  }

  // Delegación a nivel document: el "Limpiar filtros" del estado vacío vive
  // fuera del panel, y así un solo listener cubre todos los controles.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const chip = target.closest<HTMLButtonElement>('[data-chip]');
    if (chip) {
      const group = chip.dataset.chip as Group;
      const value = norm(chip.dataset.value!);
      const next = new Set(selected[group]);
      if (next.has(value)) next.delete(value);
      else next.add(value);
      setGroup(group, next);
      applyFilters();
      return;
    }

    const clearGroup = target.closest<HTMLButtonElement>('[data-clear-group]');
    if (clearGroup) {
      const group = clearGroup.dataset.clearGroup;
      // El grupo Fecha cuenta curso y cuatrimestre juntos; los limpia a la vez.
      if (group === 'fecha') {
        setGroup('cursos', new Set());
        setGroup('semesters', new Set());
      } else {
        setGroup(group as Group, new Set());
      }
      applyFilters();
      return;
    }

    if (target.closest('[data-filters-clear]')) {
      search.value = '';
      groups.forEach((g) => setGroup(g, new Set()));
      applyFilters();
    }
  });

  search.addEventListener('input', applyFilters);

  toggle.addEventListener('click', () => {
    toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
  });

  applyFilters();
</script>
