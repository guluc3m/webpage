---
/**
 * gul-Gallery — horizontal filmstrip; hovering a tile grows it and shrinks
 * its siblings (pure CSS flex-grow + :has(), no JS). Clicking opens the
 * images in gul-Lightbox.
 */
import GulLightbox from './gul-Lightbox.astro';

import { Image, getImage } from 'astro:assets';
// ImageMetadata es un tipo global de Astro, pero ESLint no lo ve: se importa
// explícitamente para que `pnpm lint` no lo marque como no definido.
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  /** Import desde src/assets — no una ruta de public/, o Astro no la optimiza. */
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: GalleryImage[];
  /** Unique per gallery on the page — becomes the id of its gul-Lightbox. */
  id: string;
  class?: string;
}

const { images, id, class: className } = Astro.props;

// El tile va por <Image> (srcset + width/height, pesos de móvil), pero el
// lightbox se abre a pantalla completa y necesita una versión grande: se
// genera aparte y es lo que recibe gul-Lightbox.
const tiles = await Promise.all(
  images.map(async (img) => ({
    ...img,
    full: (await getImage({ src: img.src, width: 1600 })).src,
  })),
);
---

{/* Por debajo de md es un carrusel con scroll-snap: cuatro tiles repartidos en
    480px salen a ~113px de ancho por 384 de alto (astillas), y el efecto de
    hover no existe en táctil. En md+ vuelve el filmstrip. */}
<div
  class:list={[
    'gul-gallery flex h-56 w-full snap-x snap-mandatory gap-2 overflow-x-auto md:h-96 md:snap-none md:overflow-visible',
    className,
  ]}
>
  {tiles.map((img, i) => (
    <button
      type="button"
      class="gul-gallery-tile relative w-4/5 shrink-0 snap-center overflow-hidden rounded-md md:w-auto md:min-w-0 md:shrink md:flex-1"
      data-gul-lightbox-open={id}
      data-index={i}
    >
      <Image
        src={img.src}
        alt={img.alt}
        widths={[400, 800]}
        sizes="(min-width: 48rem) 25vw, 80vw"
        class="h-full w-full object-cover"
      />
      <span class="gul-gallery-tile-overlay absolute inset-0 bg-gul-bg" />
    </button>
  ))}
</div>

<GulLightbox id={id} images={tiles.map(({ full, alt }) => ({ src: full, alt }))} />

<style>
  /* El filmstrip entero (crecer al pasar el ratón y el velo que se levanta al
     hacerlo) depende de :hover, que en táctil no se dispara: allí sólo dejaría
     las fotos veladas para siempre. El reparto base lo llevan las utilidades
     md:flex-1 del template, que es lo mismo que `flex: 1 1 0%`. */
  .gul-gallery-tile-overlay {
    opacity: 0;
  }

  @media (hover: hover) {
    .gul-gallery-tile {
      transition: flex-grow 0.4s ease;
    }
    .gul-gallery-tile:hover {
      flex-grow: 3;
    }
    .gul-gallery:has(.gul-gallery-tile:hover) .gul-gallery-tile:not(:hover) {
      flex-grow: 0.5;
    }
    .gul-gallery-tile-overlay {
      opacity: 0.3;
      transition: opacity 0.3s ease;
    }
    .gul-gallery-tile:hover .gul-gallery-tile-overlay {
      opacity: 0;
    }
  }
</style>
