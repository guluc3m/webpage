---
/**
 * gul-Header — the site header: GUL logo + navigation.
 *
 * Shared component (`gul-` prefix) — copied into the other GUL repos. It takes
 * the nav links as a prop so nothing about *this* site's sections is baked in.
 */
import GulNav from './gul-Nav.astro';
import GulContactDropdown from './gul-ContactDropdown.astro';

interface Props {
  links: { label: string; href: string }[];
}

const { links } = Astro.props;
---

<header class="sticky top-0 z-50 flex items-center justify-between gap-6 border-b border-gul-line/60 bg-gul-bg/70 px-6 py-3 backdrop-blur-md">
  <a href="/" aria-label="Inicio">
    {/* Dark variant: the site is always dark, and logo-gul.svg's lettering
        (#1a1a1a) is illegible against the near-black header. */}
    <img src="/logo-gul-dark.svg" alt="GUL UC3M" class="h-8 w-auto" />
  </a>
  <div class="flex items-center gap-8">
    <GulNav links={links} />
    <GulContactDropdown />
  </div>
</header>
