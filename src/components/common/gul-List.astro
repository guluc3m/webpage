---
/**
 * gul-List — an actual bulleted/numbered list. Deliberately not the default
 * look for every <ul>/<ol>: the nav and the Proyectos card grid are also
 * <ul><li> under the hood, just used for grouping with no bullets at all, so
 * that base look can't live in @layer base without breaking them. Use this
 * component when you want a real, visible list.
 */
interface Props {
  items: string[];
  ordered?: boolean;
}

const { items, ordered = false } = Astro.props;
const Tag = ordered ? 'ol' : 'ul';
---

<Tag class:list={[ordered ? 'list-decimal' : 'list-disc', 'space-y-1 pl-5 text-gul-ink']}>
  {items.map((item) => (
    <li>{item}</li>
  ))}
</Tag>
