---
/**
 * gul-Nav — the navigation link list: en md+ cada enlace es sólo su icono y
 * revela el título al pasar el ratón.
 *
 * Shared component (`gul-` prefix): meant to be copied into the other GUL repos,
 * so it takes its links as a prop instead of hard-coding this site's sections.
 * gul-Header renders it.
 *
 * Todo esto es sólo md+ (768px): la fila no cabe por debajo de ~674px. En
 * móvil se sustituye por un burger <details>, que abre y cierra sin JS.
 *
 * TODO(design): active-link highlight.
 */
interface NavLink {
  label: string;
  /** In-page anchor (`#faq`) or absolute URL (`https://gul.uc3m.es/ctf`). */
  href: string;
  /** Icono del estado compacto en md+ (clave de ICONS). */
  icon?: string;
}

interface Props {
  links: NavLink[];
  /** Utilidades de colocación para el <nav> (p. ej. el `order-*` del header). */
  class?: string;
}

const { links, class: className } = Astro.props;

// External links get target/rel; in-page anchors and other site paths don't.
const isExternal = (href: string) => href.startsWith('http');

// Hand-drawn outline icons (24x24, stroke-based) — no icon library dependency.
const ICONS = {
  info: '<circle cx="12" cy="12" r="9"/><line x1="12" y1="11" x2="12" y2="16"/><circle cx="12" cy="8" r="0.75" fill="currentColor" stroke="none"/>',
  checklist:
    '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 8h8M8 12h5M7.5 16l1.7 1.7L12.5 14.5"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  book: '<path d="M4 4h7a2 2 0 012 2v14a2 2 0 00-2-2H4zM20 4h-7a2 2 0 00-2 2v14a2 2 0 012-2h7z"/>',
  folder: '<path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>',
} as const;

// Fallback: los iconos vienen de datos (navLinks.ts), no de un literal tipado.
const icon = (name?: string) => ICONS[name as keyof typeof ICONS] ?? ICONS.info;

// Iconos propios: basta con dejar el .svg en src/icons/header/ y poner su
// nombre (sin extensión) en navLinks.ts. Se pintan como máscara sobre
// `bg-current` en vez de <img> para que sigan el color del enlace al hacer
// hover — un <img> se quedaría con el color del archivo.
const iconFiles = import.meta.glob<string>('../../icons/header/*.svg', {
  eager: true,
  query: '?url',
  import: 'default',
});
// Las comillas de url("...") no sobran: Vite inlina los svg pequeños como data
// URI, y esos llevan paréntesis que cortarían el token sin comillas.
const iconFile = (name?: string) => iconFiles[`../../icons/header/${name}.svg`];

// Estado compacto: sólo el icono. El fondo lo pinta el propio enlace (y no una
// píldora deslizante aparte) porque su ancho cambia al revelarse el texto.
const itemClass =
  'group flex h-11 cursor-pointer items-center rounded-md px-2 text-sm font-medium text-gul-muted outline-none transition-colors hover:bg-gul-ink/10 hover:text-gul-ink focus-visible:bg-gul-ink/10 focus-visible:text-gul-ink';
// El texto vive en una pista de grid que va de 0fr a 1fr. La caja que recorta
// tiene ancho 0 mientras el texto conserva el suyo y desborda: las letras se
// descubren como bajo una cortina, sin desplazarse físicamente, y el icono no
// se mueve.
const labelTrackClass =
  'grid grid-cols-[0fr] transition-[grid-template-columns] duration-300 ease-out group-hover:grid-cols-[1fr] group-focus-visible:grid-cols-[1fr] motion-reduce:transition-none';
const labelClipClass = 'overflow-hidden';
const labelTextClass =
  'inline-block pl-2 whitespace-nowrap opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:transition-none';
---

<nav aria-label="Principal" class:list={['relative', className]}>
  {/* Burger (< md). <details> nativo: abre sin JS y sigue funcionando con el
      script desactivado. Aquí sólo se anula lo que sobra para un burger (borde
      inferior y la flecha del propio ≡). */}
  <details class="gul-burger relative border-b-0 md:hidden">
    <summary
      class="flex size-9 cursor-pointer items-center justify-center rounded-md px-0 py-0 text-gul-muted hover:text-gul-ink"
      aria-label="Menú"
    >
      <svg viewBox="0 0 24 24" class="size-5 stroke-current stroke-2" fill="none">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </summary>
    {/* El ancho se recorta al viewport porque el panel se ancla a la izquierda
        del burger, que en móvil es el primer elemento del header. */}
    <div class="absolute top-full left-0 z-20 mt-2 w-[min(20rem,calc(100vw-2rem))]">
      <ul class="rounded-md border border-gul-line bg-gul-surface/95 p-2 backdrop-blur-md">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-3 py-2 text-sm font-medium text-gul-muted hover:bg-gul-ink/10 hover:text-gul-ink"
              {...(isExternal(link.href) ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </details>

  <ul class="hidden flex-wrap items-center gap-1 md:flex">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class={itemClass}
          {...(isExternal(link.href) ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {iconFile(link.icon) ? (
            <span
              class="size-7.5 shrink-0 bg-current"
              style={`mask: url("${iconFile(link.icon)}") center / contain no-repeat`}
            />
          ) : (
            <svg
              viewBox="0 0 24 24"
              class="size-7.5 shrink-0 stroke-current stroke-[1.5]"
              fill="none"
              set:html={icon(link.icon)}
            />
          )}
          <span class={labelTrackClass}>
            <span class={labelClipClass}>
              <span class={labelTextClass}>{link.label}</span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* La flecha que @layer base pone en todo <summary> sobra en el burger: su
     indicador es el propio icono ≡. */
  .gul-burger > summary::after {
    content: none;
  }
</style>
