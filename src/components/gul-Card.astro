---
/**
 * gul-Card — the card pattern used for Proyectos and anywhere else a linked
 * content card is needed. Renders a <div>; wrap it in <li> yourself when the
 * parent is a <ul> (Tailwind's preflight already strips list bullets, so a
 * card grid built on <ul><li> never needs to fight them off).
 */
import GulFrame from './gul-Frame.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  /** Optional index label, e.g. "01" — shown above the title. */
  index?: string;
}

const { href, title, description, index } = Astro.props;
const isExternal = href.startsWith('http');
---

<GulFrame variant="full" surface class="p-6 transition-colors hover:border-gul-ink/40">
  {index && <span class="text-xs text-gul-muted">{index}</span>}
  <a href={href} class="mt-2 block font-medium text-gul-ink" {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}>
    {title}
  </a>
  <p class="mt-2 text-sm text-gul-muted">{description}</p>
</GulFrame>
