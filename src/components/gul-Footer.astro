---
/**
 * gul-Footer — the legal footer.
 *
 * Shared component (`gul-` prefix): every GUL subpage carries the same legal
 * block, so it lives here and gets copied verbatim into the other repos.
 *
 * The registration data below is COPIED VERBATIM from the 2021 site and must not
 * be paraphrased. Update it only against an official association document.
 *
 * TODO(assets): the social links were icons on the old site — swap the text for
 * the SVGs in the assets step.
 */
import { SOCIALS, CONTACT } from '../config.ts';
---

<footer id="legal" class="relative overflow-hidden border-t border-gul-line bg-gul-surface p-6 text-center text-sm text-gul-muted">
  <p class="flex justify-center gap-4">
    {
      SOCIALS.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" class="hover:text-gul-ink">
          {s.label}
        </a>
      ))
    }
  </p>

  <!-- Contacto. Email obfuscated on purpose — no mailto:. Telegram is QR-only
       (see the Telegram section); Discord is invite-only via email. -->
  <p class="mt-4">Contacto: {CONTACT.email}</p>
  <p class="mt-1">
    <a href={CONTACT.mailingList} target="_blank" rel="noopener" class="hover:text-gul-ink">
      Lista de correo
    </a>{' '}
    · Discord (reuniones telemáticas): pídenos invitación por correo
  </p>

  <p class="mt-4">
    El Grupo de Usuarios de Linux de la Universidad Carlos III de Madrid es una asociación declarada
    de beneficio social por el Ministerio de Hacienda.
  </p>
  <p class="mt-2">
    Domicilio social: Despacho 2.3.C05 del edificio Sabatini. Avenida de la Universidad, 30, 28911
    Leganés, Madrid, España.
  </p>
  <p class="mt-2">
    C.I.F.: G83296988
    <br />
    Número de registro de la comunidad de Madrid: 23500
    <br />
    Número de registro del ayuntamiento de Leganés: 795
  </p>

  <p class="mt-4">
    <a
      href="https://cloud-gul.uc3m.es/s/s5TRM78die8rdAc"
      target="_blank"
      rel="noopener"
      title="link a los estatutos"
      class="hover:text-gul-ink"
    >
      Estatutos
    </a>
    |
    <a
      href="https://cloud-gul.uc3m.es/s/f8ALGXstCpJa5Lc"
      target="_blank"
      rel="noopener"
      title="link al código de conducta"
      class="hover:text-gul-ink"
    >
      Código de Conducta
    </a>
  </p>

  <!-- Ghost wordmark, purely decorative — ignored by assistive tech. -->
  <p
    aria-hidden="true"
    class="pointer-events-none mt-8 -mb-8 truncate text-[12rem] leading-none font-bold text-gul-line select-none sm:text-[16rem]"
  >
    GUL
  </p>
</footer>
