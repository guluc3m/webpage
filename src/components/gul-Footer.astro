---
/**
 * gul-Footer — the legal footer.
 *
 * Shared component (`gul-` prefix): every GUL subpage carries the same legal
 * block, so it lives here and gets copied verbatim into the other repos.
 *
 * The registration data below is COPIED VERBATIM from the 2021 site and must not
 * be paraphrased. Update it only against an official association document.
 */
import { SOCIALS, CONTACT, ADDRESS } from '../config.ts';

// `?url` forces Vite to hand back the built asset URL instead of Astro's
// ImageMetadata object (which a plain <img src> can't consume directly) -
// static imports only, so each file needs its own line, not a templated path.
import githubIcon from '../icons/rrss/github.svg?url';
import youtubeIcon from '../icons/rrss/youtube.svg?url';
import twitterIcon from '../icons/rrss/twitter.svg?url';
import igIcon from '../icons/rrss/ig.svg?url';
import linkedinIcon from '../icons/rrss/linkedin.svg?url';

const ICONS: Record<string, string> = {
  'github.svg': githubIcon,
  'youtube.svg': youtubeIcon,
  'twitter.svg': twitterIcon,
  'ig.svg': igIcon,
  'linkedin.svg': linkedinIcon,
};
---

<footer id="legal" class="border-t border-gul-line bg-gul-surface text-sm text-gul-muted">
  <div class="mx-auto max-w-5xl p-8">
    <div class="grid gap-8 md:grid-cols-3 md:justify-items-center">
      <div>
        <h2 class="font-heading text-gul-ink">Encuéntranos</h2>
        <p class="mt-3 flex gap-3">
          {SOCIALS.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="opacity-80 hover:opacity-100">
              {/* loading="lazy": these SVGs draw themselves in once on load (fill-freeze
                  animate) - eager-loading would finish that draw off-screen before the
                  footer ever scrolls into view, so it'd look static. Lazy loading defers
                  the fetch (and the animation) until it's actually visible. */}
              <img src={ICONS[s.icon]} alt="" loading="lazy" class="h-8 w-8 invert" />
            </a>
          ))}
        </p>
      </div>

      <div>
        <h2 class="font-heading text-gul-ink">Contáctanos</h2>
        <!-- Email obfuscated on purpose - no mailto:. Telegram is QR-only
             (see the Telegram section); Discord is invite-only via email. -->
        <p class="mt-3"><span class="text-gul-ink">Correo:</span> {CONTACT.email}</p>
        <p class="mt-1"><span class="text-gul-ink">Visita:</span> {ADDRESS}</p>
      </div>

      <div>
        <h2 class="font-heading text-gul-ink">Documentos</h2>
        <ul class="mt-3 space-y-1">
          <li>
            <a href="https://cloud-gul.uc3m.es/s/s5TRM78die8rdAc" target="_blank" rel="noopener" class="underline decoration-gul-line underline-offset-4 hover:text-gul-ink hover:decoration-gul-ink">
              Estatutos
            </a>
          </li>
          <li>
            <a href="https://cloud-gul.uc3m.es/s/f8ALGXstCpJa5Lc" target="_blank" rel="noopener" class="underline decoration-gul-line underline-offset-4 hover:text-gul-ink hover:decoration-gul-ink">
              Código de Conducta
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2 md:divide-x md:divide-gul-line">
      <div class="flex p-10">
        <img src="/logo-gul-dark.svg" alt="GUL" class="h-full w-full object-contain" />
      </div>

      <div class="p-6">
        <p>
          El Grupo de Usuarios de Linux de la Universidad Carlos III de Madrid es una asociación declarada
          de beneficio social por el Ministerio de Hacienda.
        </p>
        <p class="mt-2"><span class="text-gul-ink">Domicilio social:</span> {ADDRESS}, España.</p>
        <p class="mt-2">
          <span class="text-gul-ink">C.I.F.:</span> G83296988
          <br />
          <span class="text-gul-ink">Número de registro de la comunidad de Madrid:</span> 23500
          <br />
          <span class="text-gul-ink">Número de registro del ayuntamiento de Leganés:</span> 795
        </p>
      </div>
    </div>
  </div>
</footer>
