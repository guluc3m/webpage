---
/**
 * EventoBanner — franja de la próxima actividad, a todo el ancho y justo debajo del hero.
 *
 * NO HAY NADA QUE EDITAR AQUÍ: sale sola de src/data/actividades.yaml. Entre las actividades con
 * fecha futura se enseña la que antes empieza (título, descripción, `time`/`endTime`, `place`),
 * y su `link` es el botón «Saber más» (sin `link`, sin botón). Si no queda ninguna, no hay banner.
 *
 * El cartel (`poster`) da los colores: al construir la web se lee la imagen y se saca de ella el
 * fondo, el texto y el acento (src/lib/color.ts), ajustados para que siempre se lea (contraste
 * AA). Se lee tanto si vive en public/ (`/actividades/…`) como si es una URL externa (se
 * descarga en build); si falta o la descarga falla, el banner usa la paleta de la web.
 *
 * Se comprueba dos veces que el evento no ha acabado, porque la web es estática y el build no se
 * repite solo: al construirla (el HTML ya sale sin banner) y en el navegador (por si llega una
 * versión construida antes de que acabara). La lógica vive en src/lib/evento.ts.
 *
 * El dithering (PixelDissolve) es el mismo de gul-Frame y gul-Button, teñido con el acento.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import PixelDissolve from '@components/common/PixelDissolve.astro';
import GulTerminal from '@components/common/gul-Terminal.astro';
import { loadActividades } from '@lib/actividades.ts';
import { conFechas, formatearFecha, proximoEvento } from '@lib/evento.ts';
import { renderInlineMarkdown } from '@lib/markdown.ts';
import { paletaDeImagen, paletaDeUrl } from '@lib/paletaImagen.ts';
import { ALPHA_DITHERING, hexARgb, revisarContraste, rgbATriplete } from '@lib/color.ts';
import rawActividades from '@data/actividades.yaml?raw';

// Se evalúa al construir la web. Si el build es posterior al evento, `evento` es undefined y el
// HTML sale sin banner.
const evento = proximoEvento(conFechas(loadActividades(rawActividades)));

const { dia, hora } = evento ? formatearFecha(evento) : { dia: '', hora: '' };

// El cartel solo se lee si está en public/: el build corre en la raíz del proyecto. Un cartel
// remoto (URL http) se descarga en build; si la descarga falla, paletaDeUrl avisa y da
// undefined y el banner usa su paleta por defecto.
const poster = evento?.poster;
const delCartel = await (poster?.startsWith('/') && existsSync(join('public', poster))
  ? paletaDeImagen(join('public', poster))
  : poster?.startsWith('http')
    ? paletaDeUrl(poster)
    : undefined);
const colores = {
  fondo: delCartel?.fondo ?? 'var(--color-gul-surface)',
  texto: delCartel?.texto ?? 'var(--color-gul-ink)',
  apagado: delCartel?.apagado ?? 'var(--color-gul-muted)',
  borde: delCartel?.borde ?? 'var(--color-gul-line)',
  acento: delCartel?.acento ?? 'var(--color-gul-blue)',
  // Blanco y no el crema de la web: sobre el azul de la web, el crema da ~4,1:1 y el blanco ~5:1.
  textoAcento: delCartel?.textoAcento ?? '#ffffff',
};
// PixelDissolve pinta en canvas y necesita "r, g, b", no un color CSS. Sin triplete usa su azul.
const dithering = /^#[0-9a-f]{6}$/i.test(colores.acento)
  ? rgbATriplete(hexARgb(colores.acento))
  : undefined;

// La legibilidad no se deja a la suerte: con los colores del cartel está garantizada (color.ts),
// pero si dejara de estarlo el build FALLA con el par exacto, en vez de publicar un banner
// ilegible. Solo juzga colores en #hex; los `var(...)` no.
if (evento) {
  const fallos = revisarContraste({ ...colores, dithering });
  if (fallos.length > 0) {
    throw new Error(
      `EventoBanner («${evento.title}»): colores sin contraste suficiente (WCAG AA): ` +
        fallos.map((f) => `${f.par} ${f.contraste}:1 (mínimo ${f.minimo}:1)`).join('; ') +
        '. Cambia el `poster` de esa actividad.',
    );
  }
}

// Variables CSS (--evento-*) que usa el <style> de abajo. Además se re-tematiza gul-Terminal, que
// pinta su prompt con --color-gul-blue y su salida con --color-gul-muted, fijos: el azul de la web
// sobre un fondo azul de cartel sería invisible. Se le da `apagado`, que sí está garantizado.
const variables = {
  ...Object.fromEntries(
    Object.entries(colores).map(([nombre, valor]) => [
      `--evento-${nombre.replace(/[A-Z]/g, (m) => '-' + m.toLowerCase())}`,
      valor,
    ]),
  ),
  '--color-gul-blue': colores.apagado,
  '--color-gul-muted': colores.apagado,
};
---

{evento && (
  <section
    id="evento"
    aria-labelledby="evento-titulo"
    class="evento relative w-full overflow-hidden border-y"
    data-evento
    data-inicio={evento.inicio}
    data-fin={evento.fin}
    style={variables}
  >
    {/* Más tenue y más pegado a la derecha que en gul-Card (alpha .3, falloff 1.6): aquí el
        dithering pasa por detrás de párrafos enteros y no debe ensuciar su lectura. El alfa es
        ALPHA_DITHERING, el mismo con el que color.ts garantiza el contraste del texto encima. */}
    <PixelDissolve
      variant="full"
      color={dithering}
      alpha={ALPHA_DITHERING}
      falloff={1.9}
      maxDensity={0.8}
    />

    <div
      class:list={[
        // minmax(0,…) y no el `auto` por defecto: con un mínimo implícito la rejilla crece más que el
        // viewport en cuanto el texto es grande o hay una palabra larga (WCAG 1.4.4 y 1.4.10).
        'gul-gutter relative z-10 mx-auto grid max-w-gul-content grid-cols-[minmax(0,1fr)] items-center gap-8 py-10',
        evento.poster && 'md:grid-cols-[minmax(0,1fr)_min(18rem,40%)] md:gap-12',
      ]}
    >
      <div class="flex flex-col gap-5 [overflow-wrap:anywhere]">
        <p class="evento__etiqueta flex gap-2 font-mono text-sm font-medium tracking-[0.2em] uppercase">
          <span aria-hidden="true">&gt;</span>
          Próximo evento
        </p>

        <div>
          <h2 id="evento-titulo">{evento.title}</h2>
          {/* Decoración: un lector de pantalla leería "gul@uc3m $> atq", que no dice nada. */}
          <div aria-hidden="true">
            <GulTerminal lines={[{ command: 'atq' }]} />
          </div>
          {evento.description && (
            <p
              class="evento__apagado mt-4 line-clamp-4 max-w-prose"
              set:html={renderInlineMarkdown(evento.description)}
            />
          )}
        </div>

        <dl class="evento__datos grid gap-x-4 gap-y-2 font-mono text-sm">
          <dt>fecha</dt>
          <dd>
            <time datetime={evento.inicio}>
              {dia}, <span class="whitespace-nowrap">{hora}</span>
            </time>
          </dd>
          {evento.place && (
            <>
              <dt>lugar</dt>
              <dd>{evento.place}</dd>
            </>
          )}
        </dl>

        {evento.link && (
          <div class="flex flex-wrap gap-3">
            <a
              href={evento.link}
              target="_blank"
              rel="noopener"
              class="evento__boton evento__boton--principal"
            >
              <span aria-hidden="true">&gt;</span>
              Saber más
              <span class="sr-only">{` sobre ${evento.title} (se abre en una pestaña nueva)`}</span>
            </a>
          </div>
        )}
      </div>

      {evento.poster && (
        // Marco del cartel: mismo patrón que gul-Frame (borde, recorte redondeado y esquina de
        // dithering) pero con los colores del cartel. En móvil va arriba; en escritorio, a la derecha.
        <div class="evento__marco relative order-first w-full max-w-sm justify-self-center overflow-hidden rounded-md border md:order-none md:max-w-none">
          <PixelDissolve variant="corner" color={dithering} />
          <div class="relative z-10 p-2">
            {/* Sin recorte cuadrado: un cartel apaisado (como el de la Semana de la Ciencia) perdería los lados. */}
            <img
              src={evento.poster}
              alt={`Cartel de ${evento.title}`}
              class="rounded-inner-2 h-auto w-full"
            />
          </div>
        </div>
      )}
    </div>
  </section>
)}

<style>
  /* Todos los colores salen de las variables --evento-* que pone el <section> arriba. */
  .evento {
    background-color: var(--evento-fondo);
    border-color: var(--evento-borde);
    color: var(--evento-texto);
  }
  .evento h2 {
    color: var(--evento-texto);
  }
  /* El "## " con que global.css estrena los h2, aquí con el acento del evento. */
  .evento h2::before {
    color: var(--evento-acento);
  }
  /* Todo el texto pequeño (etiqueta, descripción, glifos ">" y "$") va en `texto` o `apagado`, que
     están garantizados a 4,5:1. El acento NO se usa en texto pequeño: un color cualquiera de un
     cartel no tiene por qué llegar a 4,5:1 sobre el fondo con dithering. Se ve en el "##", el
     botón principal, el foco y el propio dithering. */
  .evento__etiqueta {
    color: var(--evento-apagado);
  }
  .evento__apagado,
  .evento__datos dt {
    color: var(--evento-apagado);
  }
  /* La descripción sale de renderInlineMarkdown, que pinta negritas y enlaces con el crema de la
     web: sobre un fondo claro de cartel no se leería. */
  .evento__apagado :global(b),
  .evento__apagado :global(a) {
    color: var(--evento-texto);
  }
  .evento__datos {
    grid-template-columns: auto 1fr;
  }
  .evento__datos dd a {
    text-decoration: underline;
    text-decoration-color: var(--evento-borde);
    text-underline-offset: 4px;
  }
  .evento__datos dd a:hover {
    text-decoration-color: var(--evento-texto);
  }
  .evento__marco {
    background-color: var(--evento-fondo);
    border-color: var(--evento-borde);
  }

  .evento__boton {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border-radius: var(--radius-md);
    padding: 0.5rem 0.75rem;
    /* 44 px de alto: objetivo táctil cómodo (WCAG 2.5.8 pide 24 como mínimo). min-height y no
       height, para que crezca si el usuario agranda la letra. */
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      background-color 100ms,
      color 100ms,
      border-color 100ms;
  }
  .evento__boton--principal {
    background-color: var(--evento-acento);
    border: 1px solid var(--evento-acento);
    color: var(--evento-texto-acento);
  }
  /* Hover/foco: inversión "línea seleccionada de terminal", como gul-Button. El texto pasa
     a `fondo` (no a `acento`) para que el contraste siga alto sobre el color claro. */
  .evento__boton--principal:hover,
  .evento__boton--principal:focus-visible {
    background-color: var(--evento-texto);
    border-color: var(--evento-texto);
    color: var(--evento-fondo);
  }
  .evento__boton:focus-visible {
    outline: 2px solid var(--evento-acento);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .evento__boton {
      transition: none;
    }
  }
</style>

<script>
  import '@lib/caducaEventos.ts';
</script>
