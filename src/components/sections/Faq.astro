---
/**
 * Faq — frequently asked questions.
 *
 * TODO! : real questions and answers (placeholders for now).
 */
import GulAccordion from '@components/common/gul-Accordion.astro';
import GulTerminal from '@components/common/gul-Terminal.astro';

const items = [
  { q: '¿Cómo me apunto al GUL?', a: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.' },
  {
    q: '¿Hay que saber Linux?',
    a: 'Sed non risus. Suspendisse lectus tortor, dignissim sit amet.',
  },
  { q: '¿Cuándo quedáis?', a: 'Cras elementum ultrices diam. Maecenas ligula massa, varius a.' },
