---

<section id="faq" class="mx-auto max-w-3xl p-8">
  <h2 class="text-3xl font-bold text-gul-ink">FAQ</h2>
  <GulTerminal lines={[{ command: 'man faq' }]} />
  <div class="mt-4">
    <GulAccordion items={items} />
  </div>
</section>
