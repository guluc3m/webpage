---
/**
 * Hero — the first screen. Conway's Game of Life runs as the background
 * (GameOfLife is positioned absolutely inside this section's relative box).
 *
 * Shows a random "fortuna" (GUL in-joke) under the slogan. The quote is picked
 * and formatted here, at build time — it changes on each rebuild, not per visit.
 */
import GameOfLife from './GameOfLife.astro';
import ShaderBackground from './ShaderBackground.astro';
import StaticHeroBackground from './StaticHeroBackground.astro';
import GulEyebrow from '@components/common/gul-Eyebrow.astro';
import GulDecryptText from '@components/common/gul-DecryptText.astro';
import GulButton from '@components/common/gul-Button.astro';
import GulAchievement from '@components/common/gul-Achievement.astro';
import { loadFortunas } from '@lib/fortunas.ts';
import rawFortunas from '@data/fortunas.yaml?raw';

const formattedFortunas = loadFortunas(rawFortunas);
const fortuna = formattedFortunas[Math.floor(Math.random() * formattedFortunas.length)]; // fallback fortuna
---

{/* min-h-svh, no min-h-screen: 100vh en móvil cuenta la barra del navegador
    como si no estuviera, dejando el hero más alto que la pantalla visible. */}
<section id="inicio" class="relative flex min-h-svh items-center overflow-hidden">
  <StaticHeroBackground />
  <ShaderBackground />
  <GameOfLife />
  <div class="relative max-w-3xl px-4 py-8 sm:px-8 md:px-32">
    <GulEyebrow class="mb-4">
      <span>
        Grupo de Usuarios de Linux de la{' '}
        <a
          href="https://uc3m.es"
          target="_blank"
          rel="noopener"
          class="underline decoration-gul-line underline-offset-4 hover:text-gul-ink hover:decoration-gul-ink"
        >
          UC3M
        </a>
      </span>
    </GulEyebrow>
    <h1 class="text-4xl tracking-tight sm:text-5xl md:text-6xl">
      Nos gusta <em class="italic">jugar</em> con la tecnología
    </h1>
    <figure class="mt-6">
      {/* whitespace-pre-line: the formatter may put a *stage direction* on its own line */}
      <GulDecryptText
        as="blockquote"
        text={fortuna.quote}
        decryptOnLoad={false}
        class="whitespace-pre-line"
        data-fortuna-quote
      />
      <figcaption data-fortuna-author-wrap hidden={!fortuna.author}>
        <span aria-hidden="true">— </span>
        <GulDecryptText text={fortuna.author} decryptOnLoad={false} data-fortuna-author />
      </figcaption>
      <GulButton
        variant="secondary"
        label="Otra fortuna"
        icon="↻"
        class="mt-4"
        data-refresh-fortuna
      />
    </figure>
  </div>

  <GulAchievement
    id="fortunas-completadas"
    text="Has leído todas las {formattedFortunas.lenght} fortunas"
  />
</section>

<script define:vars={{ formattedFortunas }}>
  const quote = document.querySelector('[data-fortuna-quote]');
  const author = document.querySelector('[data-fortuna-author]');
  const authorWrap = document.querySelector('[data-fortuna-author-wrap]');
  const refresh = document.querySelector('[data-refresh-fortuna]');

  // Use indexes rather than the fortuna objects themselves. `define:vars`
  // serializes each variable separately, so the initial fortuna object does
  // not share identity with the matching object in `formattedFortunas`.
  const fortunasIndexes = new Set(formattedFortunas.map((_, index) => index));
  const repeatedIndexes = new Set();
  let currentFortunaIndex = 0;
  let achievement_unlocked = false;

  function decryptAuthor() {
    if (!authorWrap.hidden) {
      author.removeAttribute('data-decrypt-paused');
      document.dispatchEvent(new CustomEvent('gul:decrypt:resume', { detail: author }));
    }
  }

  quote.addEventListener('gul:decrypt:complete', (event) => {
    if (event.target === quote) decryptAuthor();
  });

  function randomFortuna(animate = true) {
    // compute a random fortuna. we ensure no fortuna is repeated, until all
    // fortunas are covered.
    let available = Array.from(fortunasIndexes.difference(repeatedIndexes));

    if (available.length === 0) {
      // all fortunas were done, repeat
      repeatedIndexes.clear();
      // prevent show the same fortuna again
      repeatedIndexes.add(currentFortunaIndex);
      available = Array.from(fortunasIndexes.difference(repeatedIndexes));
    }

    const nextIndex = available[Math.floor(Math.random() * available.length)];
    const next = formattedFortunas[nextIndex];

    repeatedIndexes.add(nextIndex);
    currentFortunaIndex = nextIndex;

    // show fortuna
    quote.textContent = next.quote;
    if (animate) {
      quote.dispatchEvent(new CustomEvent('gul:decrypt', { bubbles: true, detail: quote }));
    }
    author.textContent = next.author;
    authorWrap.hidden = !next.author;
    if (animate && next.author) {
      author.dataset.decryptPaused = 'true';
      document.dispatchEvent(new CustomEvent('gul:decrypt', { detail: author }));
    } else {
      author.removeAttribute('data-decrypt-paused');
    }

    // achievement
    if (!achievement_unlocked && fortunasIndexes.size === repeatedIndexes.size) {
      document.dispatchEvent(
        new CustomEvent('gul:achievement:show', { detail: 'fortunas-completadas' }),
      );
      achievement_unlocked = true;
    }
  }

  // as the build part will always provide the same "fallback" fortuna, we
  // re-generate a new random fortuna client-side
  randomFortuna(false);

  refresh?.addEventListener('click', randomFortuna);
</script>
