---
/**
 * StaticHeroBackground — no-JS fallback for the hero canvases.
 *
 * JavaScript paints the live layers over this. If JavaScript is unavailable,
 * what stays is the base background plus a Tux silhouette on non-mobile
 * layouts, loaded as a CSS background from /hero-fallback.svg
 * (src/pages/hero-fallback.svg.ts).
 *
 * The artwork is a background image, not inline markup, precisely so it costs
 * nothing: browsers don't request backgrounds of `display: none` elements, and
 * both branches below are hidden whenever the artwork is not needed — with JS
 * (html.js) and on phones (media query).
 */
---

{/* Runs before the hero renders, so JS-enabled browsers never paint the no-JS
    artwork. */}
<script is:inline>
  document.documentElement.classList.add('js');
</script>

{/* The URL lives in a style attribute, not in the <style> block below: the
    file is a page route (src/pages/hero-fallback.svg.ts), so it doesn't exist
    on disk while the bundler resolves stylesheets and would be reported as a
    broken reference on every build. */}
<div
  aria-hidden="true"
  style="--hero-fallback: url('/hero-fallback.svg')"
  class="hero-static-background hero-static-background--desktop pointer-events-none absolute inset-0"
></div>

{/* No Tux on phones (it would sit on top of the text), so this branch is just
    the background colour. */}
<div
  aria-hidden="true"
  class="hero-static-background hero-static-background--mobile pointer-events-none absolute inset-0"
></div>

<style>
  html.js .hero-static-background {
    display: none !important;
  }

  .hero-static-background--desktop {
    display: block;
    /* background-position/size stand in for the SVG's old
       preserveAspectRatio="xMaxYMax meet": square cells, Tux whole and
       anchored bottom-right, gradient behind the leftover space. */
    background:
      var(--hero-fallback) right bottom / contain no-repeat,
      linear-gradient(135deg, rgba(141, 140, 156, 0.1) 0%, rgb(0 117 176 / 0.05) 100%),
      #050504;
  }

  .hero-static-background--mobile {
    display: none;
    background: #0a0a09;
  }

  /* Same condition as NO_TUX in GameOfLife.astro: Tux is desktop and tablet
     only, so the text keeps its contrast in any phone orientation. If it
     changes here, change it there too. */
  @media (max-width: 29.999rem), (max-aspect-ratio: 3 / 4) {
    .hero-static-background--desktop {
      display: none;
    }

    .hero-static-background--mobile {
      display: block;
    }
  }
</style>
