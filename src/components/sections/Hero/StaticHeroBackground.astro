---
/**
 * StaticHeroBackground — build-time fallback for the hero canvases.
 *
 * JavaScript paints the live shader and Game of Life layers over this SVG. If
 * JavaScript is unavailable, the server-rendered HTML keeps only the base
 * background and a Tux silhouette on non-mobile layouts.
 */
import { computeTuxBitmap } from '@lib/tuxBitmap.ts';
import { sampleTuxMask } from '@lib/tux.ts';
import tuxSvg from '/tux.svg?raw';

// Una sola rejilla para todo el escritorio, en 16:10. Antes había tres (16:9,
// 16:10, 4:3) porque el SVG se estiraba con preserveAspectRatio="none" y cada
// relación de aspecto necesitaba la suya para no deformar las celdas: sumaban
// 167KB de los 312KB del HTML y llegaban íntegras a cada móvil, que no pinta
// ninguna. Con "xMaxYMax meet" la escala es uniforme (celdas cuadradas en
// cualquier viewport), Tux queda entero y anclado abajo a la derecha, y el
// hueco sobrante lo cubre el degradado de fondo del CSS — que es justo lo que
// hace también el canvas, así que fallback y versión con JS coinciden.
const CELL = 10;
const GAP = 2;
const COLS = 128;
const ROWS = 80;
const TUX_HEIGHT_FRACTION = 0.86;
const TUX_X_FRACTION = 0.9;

const tuxBitmap = await computeTuxBitmap(Buffer.from(tuxSvg), 80, 80);
const tuxMask = sampleTuxMask(tuxBitmap, COLS, ROWS, TUX_HEIGHT_FRACTION, TUX_X_FRACTION);

// Sólo las celdas encendidas: el resto del fondo lo pone el CSS.
const cells = Array.from({ length: COLS * ROWS }, (_, index) => ({
  x: index % COLS,
  y: Math.floor(index / COLS),
  tux: tuxMask[index] === 1,
})).filter(({ tux }) => tux);
---

{/* Run before the large inline SVGs are parsed, so JS-enabled browsers never
    get a chance to paint the no-JS artwork. */}
<script is:inline>
  document.documentElement.classList.add('js');
</script>

<svg
  aria-hidden="true"
  class="hero-static-background hero-static-background--desktop pointer-events-none absolute inset-0 h-full w-full"
  viewBox={`0 0 ${COLS * CELL} ${ROWS * CELL}`}
  preserveAspectRatio="xMaxYMax meet"
>
  {cells.map(({ x, y }) => (
    <rect x={x * CELL} y={y * CELL} width={CELL - GAP} height={CELL - GAP} fill="#ece7d8" />
  ))}
</svg>

{/* En móvil no hay Tux (taparía el texto), así que la variante se queda en el
    color de fondo: un div, sin SVG que descargar. */}
<div
  aria-hidden="true"
  class="hero-static-background hero-static-background--mobile pointer-events-none absolute inset-0"
></div>

<style>
  html.js .hero-static-background {
    display: none !important;
  }

  .hero-static-background--desktop {
    display: block;
    background:
      linear-gradient(135deg, rgba(141, 140, 156, 0.1) 0%, rgb(0 117 176 / 0.05) 100%), #050504;
    background-size: 100% 100%;
    background-repeat: no-repeat;
  }

  .hero-static-background--mobile {
    display: none;
    background: #0a0a09;
  }

  /* Misma condición que NO_TUX en GameOfLife.astro: Tux es sólo de escritorio
     y tablet, para que el texto conserve contraste en cualquier orientación de
     teléfono. Si se cambia aquí, cambiarla también allí. */
  @media (max-width: 29.999rem), (max-aspect-ratio: 3 / 4) {
    .hero-static-background--desktop {
      display: none;
    }

    .hero-static-background--mobile {
      display: block;
    }
  }
</style>
