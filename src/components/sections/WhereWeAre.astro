---
/**
 * WhereWeAre — "¿Dónde estamos?" section: the map plus the postal address.
 * Address copied verbatim from the 2021 site.
 */
import Map from './Map.astro';
import GulTerminal from '@components/common/gul-Terminal.astro';
---

<section id="donde-estamos" class="mx-auto max-w-3xl p-8">
  <h2>¿Dónde estamos?</h2>
  <GulTerminal
    lines={[
      {
        command: 'hostnamectl | grep Location',
        output: 'Location: <b>Despacho 2.3.C05, Edificio Sabatini, EPS-UC3M</b>',
      },
      {
        command: 'which EPS-UC3M',
        output: '<b>Avenida de la Universidad, 30, 28911 Leganés, Madrid</b>',
      },
    ]}
  />

  <div class="m-4" rounded-md>
    <img src="/real/despacho.jpg" alt="Despacho del GUL" class="gul-gallery-image" />
  </div>

  <div class="mt-4 overflow-hidden rounded-md border border-gul-line">
    <Map />
  </div>
</section>
