---
/**
 * WhereWeAre — "¿Dónde estamos?" section: the map plus the postal address.
 * Address copied verbatim from the 2021 site.
 */
import { Image } from 'astro:assets';
import Map from './Map.astro';
import GulTerminal from '@components/common/gul-Terminal.astro';
import GulFrame from '@components/common/gul-Frame.astro';
import despacho from '@assets/real/despacho.jpg';
---

<section id="donde-estamos" class="gul-gutter mx-auto max-w-gul-content py-8">
  <h2>¿Dónde estamos?</h2>
  <div class="mt-4 grid gap-4 md:grid-cols-10">
    <div class="flex flex-col gap-4 md:col-span-6">
      <GulTerminal
        lines={[
          {
            command: 'hostnamectl | grep Location',
            output: 'Location: <b>Despacho 2.3.C05, Edificio Sabatini, EPS-UC3M</b>',
          },
          {
            command: 'which EPS-UC3M',
            output: '<b>Avenida de la Universidad, 30, 28911 Leganés, Madrid</b>',
          },
        ]}
      />

      <GulFrame surface class="p-2">
        <Image
          src={despacho}
          alt="Despacho del GUL"
          widths={[400, 800]}
          sizes="(min-width: 48rem) 40vw, 100vw"
          class="w-full rounded-md"
        />
      </GulFrame>
    </div>

    <div class="overflow-hidden rounded-md border border-gul-line md:col-span-4">
      <Map />
    </div>
  </div>
</section>
