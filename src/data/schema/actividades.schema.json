{
  "$ref": "#/definitions/Actividades",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Actividad": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "yyyy/mm/dd",
          "type": "string"
        },
        "endTime": {
          "description": "HH:MM, same day as `date`; needs `time`",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string"
        },
        "place": {
          "description": "Only shown while the activity is upcoming",
          "type": "string"
        },
        "time": {
          "description": "HH:MM (Madrid time)",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string"
        },
        "description": {
          "description": "Supports basic markdown",
          "type": "string"
        },
        "link": {
          "description": "Generic link to add",
          "type": "string"
        },
        "participants": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/Participant"
              }
            ]
          },
          "type": "array"
        },
        "photos": {
          "description": "Photos of the event; the poster, if any, stays the cover",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "poster": {
          "type": "string"
        },
        "slides": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/ActividadType"
        },
        "video": {
          "type": "string"
        }
      },
      "required": ["title", "date", "type"],
      "type": "object"
    },
    "ActividadType": {
      "enum": [
        "Charla",
        "Taller",
        "Hackathon",
        "CTF",
        "Install party",
        "Game jam",
        "Pódcast",
        "Radio",
        "Congreso",
        "Feria de Asociaciones"
      ],
      "type": "string"
    },
    "Actividades": {
      "items": {
        "$ref": "#/definitions/Actividad"
      },
      "type": "array"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "link": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["name"],
      "type": "object"
    }
  }
}
