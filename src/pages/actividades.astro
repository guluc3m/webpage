---
/**
 * /actividades — histórico de talleres y charlas del GUL (guluc3m/webpage#9).
 * Datos en src/data/actividades.yaml, más los congresos (Jornadas Técnicas…)
 * de congresos.yaml, cuyas activities van cada una en su congreso (una
 * gul-CongresoCard, un poco mayor, envuelve a las ActividadCard de dentro).
 * Esta página ordena y pinta, y calcula las opciones de los filtros, que
 * viven en gul-ActividadFilters (panel lateral en md+, panel plegable tras
 * el botón "Filtros" en móvil). El filtrado corre en el cliente porque
 * depende de lo que el usuario teclea/elige, no hay nada que precomputar en
 * build.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import GulHeader from '@components/common/gul-Header.astro';
import GulFooter from '@components/common/gul-Footer.astro';
import GulActividadCard from '@components/common/gul-ActividadCard.astro';
import GulCongresoCard from '@components/common/gul-CongresoCard.astro';
import GulActividadFilters from '@components/common/gul-ActividadFilters.astro';
import { navLinks } from '@data/navLinks';
import { ACTIVIDAD_TYPES, loadActividades } from '@lib/actividades';
import { loadCongresos, type Congreso } from '@lib/congresos';
import rawActividades from '@data/actividades.yaml?raw'; // ?raw: a plain string, so invalid YAML syntax doesn't blow up the import itself.
import rawCongresos from '@data/congresos.yaml?raw';

const actividades = loadActividades(rawActividades);
const congresos = loadCongresos(rawCongresos, actividades);

// yyyy/mm/dd sorts correctly as a plain string, no Date needed for ordering.
const sorted = [...actividades].sort((a, b) => b.date.localeCompare(a.date));
// todo lo filtrable (tags, participants, tipos y los chips): las activities
// de un congreso pescan exactamente igual que las sueltas.
const internals = congresos.flatMap((c) => c.activities);

// A "curso" runs September→August, named after its starting year (e.g. "curso 2026" = Sept 2026–Aug 2027).
const cursoStart = (date: string) => {
  const [year, month] = date.split('/').map(Number);
  return month >= 9 ? year : year - 1;
};
const now = new Date();
const currentCurso = now.getMonth() + 1 >= 9 ? now.getFullYear() : now.getFullYear() - 1;
const oldestCurso =
  sorted.length > 0 ? Math.min(...sorted.map((a) => cursoStart(a.date))) : currentCurso;

// One row per curso (newest first), each holding that curso's activities and
// congresos — empty cursos still get a divider. A congreso lives in the curso
// where it starts (sus activities están dentro de la misma tarjeta), y su
// fecha de orden es la de la primera.
const congresoCurso = (c: Congreso) => {
  const first = c.activities[0];
  return first ? cursoStart(first.date) : null;
};
const rowItems = (curso: number) => [
  ...sorted
    .filter((a) => cursoStart(a.date) === curso)
    .map((a) => ({ kind: 'actividad' as const, date: a.date, actividad: a })),
  ...congresos
    .filter((c) => congresoCurso(c) === curso)
    .map((c) => ({ kind: 'congreso' as const, date: c.activities[0]!.date, congreso: c })),
];
const cursoRows = Array.from(
  { length: currentCurso - oldestCurso + 1 },
  (_, i) => currentCurso - i,
).map((curso) => ({
  curso,
  items: rowItems(curso).sort((a, b) => b.date.localeCompare(a.date)),
}));

// Tipos de actividad presentes, en el orden fijo de ACTIVIDAD_TYPES (el
// vocabulario del campo `type`). Los tags son solo temas, ordenados por
// frecuencia y alfabéticamente. Los participants van alfabéticos. Todo
// incluye las activities de los congresos, que se filtran igual.
const typeCounts = new Set([...sorted, ...internals].map((a) => a.type));
const types = ACTIVIDAD_TYPES.filter((t) => typeCounts.has(t));
const tagCounts = new Map<string, number>();
for (const a of [...sorted, ...internals])
  for (const t of a.tags ?? []) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.keys()].sort((a, b) => {
  const byCount = (tagCounts.get(b) ?? 0) - (tagCounts.get(a) ?? 0);
  return byCount !== 0 ? byCount : a.localeCompare(b, 'es');
});
const participants = [
  ...new Set([...sorted, ...internals].flatMap((a) => (a.participants ?? []).map((s) => s.name))),
].sort((a, b) => a.localeCompare(b, 'es'));

// Opciones del filtro de congresos: las series con datos, en su orden de
// primera aparición en el YAML (la serie es texto libre, no hay vocabulario fijo
// que ordene), y cada edición con su serie, en el orden del YAML (de más
// vieja a más nueva); el grupo Congresos las enseña debajo de su serie.
const congresoSeries = [...new Set(congresos.map((c) => c.series))];
const editions = congresos.map((c) => ({ title: c.title, series: c.series }));
---

<BaseLayout title="Actividades · GUL UC3M">
  <GulHeader links={navLinks} />
  <main class="mx-auto max-w-gul-content gul-gutter py-8 lg:max-w-7xl">
    <h1>Actividades</h1>

    <div class="mt-6 md:grid md:grid-cols-[16rem_minmax(0,1fr)] md:gap-10">
      <GulActividadFilters
        types={types}
        congresoSeries={congresoSeries}
        editions={editions}
        tags={tags}
        participants={participants}
        cursos={cursoRows.map(({ curso }) => curso)}
      />

      <div class="mt-8 md:mt-0">
        {/* scroll-mt: al filtrar desde una tarjeta se sube hasta aquí, y el header fijo lo taparía. */}
        <p
          class="scroll-mt-24 text-sm text-gul-muted"
          data-actividades-count
          aria-live="polite"
        ></p>

        <ul class="mt-6 space-y-10 border-l border-gul-line pl-6" data-actividades-list>
          {cursoRows.map(({ curso, items }) => (
            <>
              {/* El -ml compensa el pl-6 del ul, así que left-0 es el borde izquierdo:
                  el punto se centra ahí sobre la línea de la cronología. */}
              <li
                class="relative -ml-6.25 pl-6 before:absolute before:top-1/2 before:left-0 before:size-2.5 before:-translate-x-1/2 before:-translate-y-1/2 before:rounded-full before:bg-gul-muted"
                data-curso-marker={curso}
                data-curso-count={items.length}
              >
                <p class="text-sm font-medium tracking-[0.2em] text-gul-muted uppercase">
                  Curso {curso}–{curso + 1}
                </p>
              </li>
              {items.map((item) =>
                item.kind === 'congreso' ? (
                  /* Un congreso se esconde entero si ninguna de sus activities
                     pasa los filtros: el script ve las de dentro y este li es
                     el que aguanta la tarjeta mayor (gul-ActividadFilters). */
                  <li class="-ml-6.25 pl-6" data-actividad-group>
                    <GulCongresoCard congreso={item.congreso} curso={curso} />
                  </li>
                ) : (
                  <li
                    class="-ml-6.25 pl-6"
                    data-actividad
                    data-curso={curso}
                    data-title={item.actividad.title.toLowerCase()}
                    data-date={item.actividad.date.replaceAll('/', '-')}
                    data-type={item.actividad.type.toLowerCase()}
                    data-tags={(item.actividad.tags ?? []).join(',').toLowerCase()}
                    data-participants={(item.actividad.participants ?? [])
                      .map((s) => s.name)
                      .join(',')
                      .toLowerCase()}
                  >
                    <GulActividadCard actividad={item.actividad} />
                  </li>
                ),
              )}
            </>
          ))}
        </ul>

        <p class="mt-8 hidden text-sm text-gul-muted" data-actividades-empty>
          Ninguna actividad coincide con los filtros.
          <button
            type="button"
            class="ml-1 cursor-pointer text-xs tracking-wider text-gul-blue uppercase underline disabled:cursor-default disabled:text-gul-line"
            data-filters-clear
            disabled
          >
            Limpiar filtros
          </button>
        </p>
      </div>
    </div>
  </main>
  <GulFooter />
</BaseLayout>
