---
/**
 * /actividades — histórico de talleres y charlas del GUL (guluc3m/webpage#9).
 * Datos en src/data/actividades.ts; esta página solo ordena, filtra (título,
 * tag, participante) y pinta. El filtrado corre en el cliente porque depende de
 * lo que el usuario teclea/elige, no hay nada que precomputar en build.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import GulHeader from '@components/common/gul-Header.astro';
import GulFooter from '@components/common/gul-Footer.astro';
import GulActividadCard from '@components/common/gul-ActividadCard.astro';
import { navLinks } from '@data/navLinks';
import { loadActividades } from '@lib/actividades';
import filterIcon from '@icons/ui/filter.svg?url';
import searchIcon from '@icons/ui/search.svg?url';

const actividades = loadActividades();

// yyyy/mm/dd sorts correctly as a plain string, no Date needed for ordering.
const sorted = [...actividades].sort((a, b) => b.date.localeCompare(a.date));
const tags = [...new Set(sorted.flatMap((a) => a.tags))].sort();
const participants = [...new Set(sorted.flatMap((a) => (a.participants ?? []).map((s) => s.name)))].sort();

// A "curso" runs September→August, named after its starting year (e.g. "curso 2026" = Sept 2026–Aug 2027).
const cursoStart = (date: string) => {
  const [year, month] = date.split('/').map(Number);
  return month >= 9 ? year : year - 1;
};
const now = new Date();
const currentCurso = now.getMonth() + 1 >= 9 ? now.getFullYear() : now.getFullYear() - 1;
const oldestCurso =
  sorted.length > 0 ? Math.min(...sorted.map((a) => cursoStart(a.date))) : currentCurso;

// One row per curso (newest first), each holding that curso's activities — empty cursos still get a divider.
const cursoRows = Array.from(
  { length: currentCurso - oldestCurso + 1 },
  (_, i) => currentCurso - i,
).map((curso) => ({ curso, items: sorted.filter((a) => cursoStart(a.date) === curso) }));
---

<BaseLayout title="Actividades · GUL UC3M">
  <GulHeader links={navLinks} />
  <main class="mx-auto max-w-gul-content gul-gutter py-8">
    <h1>Actividades</h1>

    <div class="relative mt-4 sm:max-w-sm">
      <img
        src={searchIcon}
        alt=""
        class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 invert"
      />
      <input type="search" placeholder="Buscar por título…" data-filter-search class="pl-9" />
    </div>

    <details class="mt-3" data-gul-filters>
      <summary>
        <span class="flex items-center gap-2">
          <img src={filterIcon} alt="" class="size-4 invert" />
          Filtrar
        </span>
      </summary>
      <div>
        <div class="grid gap-3 pt-1 pb-4 md:grid-cols-2 lg:grid-cols-4">
          <label class="flex flex-col gap-1">
            Tag
            <select data-filter-tag>
              <option value="">Todos los tags</option>
              {tags.map((t) => (
                <option value={t}>{t}</option>
              ))}
            </select>
          </label>
          <label class="flex flex-col gap-1">
            Participante
            <select data-filter-participant>
              <option value="">Todos los participantes</option>
              {participants.map((s) => (
                <option value={s}>{s}</option>
              ))}
            </select>
          </label>
          <label class="flex flex-col gap-1">
            Desde
            <input type="date" data-filter-date-from />
          </label>
          <label class="flex flex-col gap-1">
            Hasta
            <input type="date" data-filter-date-to />
          </label>
        </div>
      </div>
    </details>

    <ul class="mt-8 space-y-10 border-l border-gul-line pl-6" data-actividades-list>
      {cursoRows.map(({ curso, items }) => (
        <>
          {/* El -ml compensa el pl-6 del ul, así que left-0 es el borde izquierdo:
              el punto se centra ahí sobre la línea de la cronología. */}
          <li
            class="relative -ml-6.25 pl-6 before:absolute before:top-1/2 before:left-0 before:size-2.5 before:-translate-x-1/2 before:-translate-y-1/2 before:rounded-full before:bg-gul-muted"
            data-curso-marker={curso}
            data-curso-count={items.length}
          >
            <p class="text-sm font-medium tracking-[0.2em] text-gul-muted uppercase">
              Curso {curso}–{curso + 1}
            </p>
          </li>
          {items.map((a) => (
            <li
              class="-ml-6.25 pl-6"
              data-actividad
              data-curso={curso}
              data-title={a.title.toLowerCase()}
              data-date={a.date.replaceAll('/', '-')}
              data-tags={a.tags.join(',').toLowerCase()}
              data-participants={(a.participants ?? [])
                .map((s) => s.name)
                .join(',')
                .toLowerCase()}
            >
              <GulActividadCard actividad={a} />
            </li>
          ))}
        </>
      ))}
    </ul>

    <p class="mt-8 hidden text-sm text-gul-muted" data-actividades-empty>
      Ninguna actividad coincide con el filtro.
    </p>
  </main>
  <GulFooter />
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-filter-search]')!;
  const tagFilter = document.querySelector<HTMLSelectElement>('[data-filter-tag]')!;
  const speakerFilter = document.querySelector<HTMLSelectElement>('[data-filter-participant]')!;
  const dateFrom = document.querySelector<HTMLInputElement>('[data-filter-date-from]')!;
  const dateTo = document.querySelector<HTMLInputElement>('[data-filter-date-to]')!;
  const items = document.querySelectorAll<HTMLLIElement>('[data-actividad]');
  const cursoMarkers = document.querySelectorAll<HTMLLIElement>('[data-curso-marker]');
  const empty = document.querySelector<HTMLElement>('[data-actividades-empty]')!;

  function applyFilters() {
    const q = search.value.trim().toLowerCase();
    const tag = tagFilter.value.toLowerCase();
    const participant = speakerFilter.value.toLowerCase();
    const from = dateFrom.value; // yyyy-mm-dd, same shape as data-date — plain string compare works
    const to = dateTo.value;
    let visible = 0;
    const visibleCursos = new Set<string>();

    items.forEach((item) => {
      const date = item.dataset.date!;
      const matches =
        item.dataset.title!.includes(q) &&
        (!tag || item.dataset.tags!.split(',').includes(tag)) &&
        (!participant || item.dataset.participants!.split(',').includes(participant)) &&
        (!from || date >= from) &&
        (!to || date <= to);
      item.hidden = !matches;
      if (matches) {
        visible++;
        visibleCursos.add(item.dataset.curso!);
      }
    });

    // A curso with no activities yet (the current one) always shows; one with activities
    // hides once the filter matches none of them.
    cursoMarkers.forEach((marker) => {
      const hasActividades = marker.dataset.cursoCount !== '0';
      marker.hidden = hasActividades && !visibleCursos.has(marker.dataset.cursoMarker!);
    });

    empty.hidden = visible > 0;
  }

  [search, tagFilter, speakerFilter, dateFrom, dateTo].forEach((el) =>
    el.addEventListener('input', applyFilters),
  );
</script>
