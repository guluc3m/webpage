---
/**
 * index.astro — the landing page, and the only page. The whole site is here.
 *
 * Its whole job is to lay out the section components in the fixed order. Section
 * content lives in each component under src/components/, not here. To reorder the
 * page, reorder these tags.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import GulHeader from '@components/common/gul-Header.astro';
import GulFooter from '@components/common/gul-Footer.astro';
import Hero from '@components/sections/Hero/Hero.astro';
import WhatIsGul from '@components/sections/WhatIsGul.astro';
import Faq from '@components/sections/Faq.astro';
import Projects from '@components/sections/Projects.astro';
import WhereWeAre from '@components/sections/WhereWeAre.astro';
import { navLinks } from '@data/navLinks';
---

<BaseLayout title="GUL UC3M">
  <GulHeader links={navLinks} />
  <main>
    <Hero />
    <WhatIsGul />
    <Faq />
    <Projects />
    <WhereWeAre />
  </main>
  <GulFooter />
</BaseLayout>
