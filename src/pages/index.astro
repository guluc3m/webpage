---
/**
 * index.astro — the landing page, and the only page. The whole site is here.
 *
 * Its whole job is to lay out the section components in the fixed order. Section
 * content lives in each component under src/components/, not here. To reorder the
 * page, reorder these tags.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import GulHeader from '../components/gul-Header.astro';
import GulFooter from '../components/gul-Footer.astro';
import Hero from '../components/Hero/Hero.astro';
import WhatIsGul from '../components/WhatIsGul.astro';
import Faq from '../components/Faq.astro';
import Projects from '../components/Projects.astro';
import WhereWeAre from '../components/WhereWeAre.astro';

// Nav: just JAMon, Jornadas and Guía — live services on gul.uc3m.es, not pages
// in this build (see CLAUDE.md "Subpages & services"). Zoe and Radio are gone.
//
// JAMon and Guía sub-items assume /jamon/ exposes a #talleres section the way
// this page uses section ids; Guía's sub-items link straight to the relevant
// file in guluc3m/linux-install since /guia/ itself just redirects there.
const navLinks = [
  {
    label: 'JAMon',
    href: '/jamon/',
    children: [
      {
        label: 'Información',
        href: '/jamon/',
        icon: 'info',
        description: 'Qué es la JAMon y cómo participar.',
      },
      {
        label: 'Talleres',
        href: '/jamon/#talleres',
        icon: 'wrench',
        description: 'Charlas y talleres previos a la jam.',
      },
      {
        label: 'Competición',
        href: 'https://itch.io/jam/gul-jamon-2025',
        icon: 'trophy',
        description: 'Inscríbete y sube tu juego en itch.io.',
      },
    ],
  },
  { label: 'Jornadas', href: '/jornadas/' },
  {
    label: 'Guía',
    href: '/guia/',
    children: [
      {
        label: 'Instalación completa',
        href: 'https://github.com/guluc3m/linux-install/blob/main/full-install.md',
        icon: 'download',
        description: 'Borra Windows y quédate solo con Linux.',
      },
      {
        label: 'Dual boot',
        href: 'https://github.com/guluc3m/linux-install/blob/main/dualboot-install.md',
        icon: 'split',
        description: 'Instala Linux junto a Windows o macOS.',
      },
      {
        label: 'Post-instalación',
        href: 'https://github.com/guluc3m/linux-install/blob/main/post-install.md',
        icon: 'checklist',
        description: 'Primeros pasos tras instalar tu distro.',
      },
      {
        label: 'Solución de problemas',
        href: 'https://github.com/guluc3m/linux-install/blob/main/troubleshoot.md',
        icon: 'alert',
        description: 'Wi-Fi, drivers y otros líos habituales.',
      },
    ],
  },
];
---

<BaseLayout title="GUL UC3M">
  <GulHeader links={navLinks} />
  <main>
    <Hero />
    <WhatIsGul />
    <Faq />
    <Projects />
    <WhereWeAre />
  </main>
  <GulFooter />
</BaseLayout>
