---
/**
 * index.astro — the landing page, and the only page. The whole site is here.
 *
 * Its whole job is to lay out the section components in the fixed order. Section
 * content lives in each component under src/components/, not here. To reorder the
 * page, reorder these tags.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import GulHeader from '../components/gul-Header.astro';
import GulFooter from '../components/gul-Footer.astro';
import Hero from '../components/Hero/Hero.astro';
import WhatIsGul from '../components/WhatIsGul.astro';
import Faq from '../components/Faq.astro';
import Projects from '../components/Projects.astro';
import Qrs from '../components/Qrs.astro';
import WhereWeAre from '../components/WhereWeAre.astro';

// Nav links: in-page anchors match each section's `id`. External service links
// (/jamon, /ctf, /guia, …) can be added here later — Zoe and Radio are gone.
const navLinks = [
  { label: '¿Qué es el GUL?', href: '#que-es-el-gul' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Telegram', href: '#qrs' },
  { label: '¿Dónde estamos?', href: '#donde-estamos' },
];
---

<BaseLayout title="GUL UC3M">
  <GulHeader links={navLinks} />
  <main>
    <Hero />
    <WhatIsGul />
    <Faq />
    <Projects />
    <Qrs />
    <WhereWeAre />
  </main>
  <GulFooter />
</BaseLayout>
