---
/**
 * /styleguide — working page to lock down HTML-element-level standards (h1–h6,
 * paragraphs, lists, cards, buttons) before they're copied into other GUL repos.
 * Not part of the public site; drop this file once the decisions in CLAUDE.md's
 * "Still open" section are settled and baked into the real components.
 *
 * Composite patterns (button, badge, card, callout, tabs, modal, eyebrow, list,
 * accordion) are demoed here through the real shared components in
 * src/components/ — not hand-copied markup — so this page can't drift from
 * what the site actually ships. Single-tag standards (headings, code, tables,
 * forms, dialog, quotes) need no component at all: they're @layer base rules
 * in global.css, applied automatically to the bare tag.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import GulHeader from '@components/common/gul-Header.astro';
import { navLinks } from '@data/navLinks';
import GulFooter from '@components/common/gul-Footer.astro';
import GulEyebrow from '@components/common/gul-Eyebrow.astro';
import GulButton from '@components/common/gul-Button.astro';
import GulContactDropdown from '@components/common/gul-ContactDropdown.astro';
import GulBadge from '@components/common/gul-Badge.astro';
import GulCard from '@components/common/gul-Card.astro';
import GulRepoCard from '@components/common/gul-RepoCard.astro';
import GulCallout from '@components/common/gul-Callout.astro';
import GulTabs from '@components/common/gul-Tabs.astro';
import GulModal from '@components/common/gul-Modal.astro';
import GulGallery from '@components/common/gul-Gallery.astro';
import GulList from '@components/common/gul-List.astro';
import GulAccordion from '@components/common/gul-Accordion.astro';
import GulFrame from '@components/common/gul-Frame.astro';
import GulCodeBlock from '@components/common/gul-CodeBlock.astro';
import GulTerminal from '@components/common/gul-Terminal.astro';
import GulCommitsGrid from '@components/common/gul-CommitsGrid.astro';
import GulAchievement from '@components/common/gul-Achievement.astro';
import PixelDissolve from '@components/common/PixelDissolve.astro';

// Decided (self-hosted via @fontsource-variable, tokens in global.css @theme).
// Read straight from the real classes — no separate demo styling to drift out
// of sync with the actual site.
const fontStacks = [
  { class: 'font-sans', label: 'font-sans — Inter (cuerpo)' },
  { class: 'font-heading font-bold', label: 'font-heading — Space Grotesk (encabezados)' },
  { class: 'font-mono', label: 'font-mono — JetBrains Mono (código)' },
];

// rounded-2xl (Cards/Acordeón/mapa) and rounded-lg (dropdown del nav) eran
// inconsistencias de antes de que la regla "rounded-md es siempre el borde
// exterior" se hiciera explícita. Todo el sitio usa rounded-md ahora.
const radii = [
  { class: 'rounded-md', label: 'rounded-md — el único para bordes exteriores en todo el sitio' },
  { class: 'rounded-2xl', label: 'rounded-2xl — sin uso' },
  { class: 'rounded-lg', label: 'rounded-lg — sin uso' },
];

// Tailwind's default spacing scale (0.25rem step) — no custom token defined.
const spacingScale = [
  { class: 'w-1', px: '4px' },
  { class: 'w-2', px: '8px' },
  { class: 'w-3', px: '12px' },
  { class: 'w-4', px: '16px' },
  { class: 'w-6', px: '24px' },
  { class: 'w-8', px: '32px' },
  { class: 'w-12', px: '48px' },
  { class: 'w-16', px: '64px' },
  { class: 'w-24', px: '96px' },
];

// sm/md decididos y ya en @theme (global.css) — sm ya no es el 640px por
// defecto de Tailwind, se redefinió a 480px. lg/xl siguen en el default,
// sin caso de uso.
const breakpoints = [
  { prefix: 'sm', minWidth: '480px', note: 'decidido — Hero, Proyectos, footer' },
  { prefix: 'md', minWidth: '768px', note: 'decidido — sin aplicar todavía a un componente real' },
  { prefix: 'lg', minWidth: '1024px', note: 'default de Tailwind, sin uso' },
  { prefix: 'xl', minWidth: '1280px', note: 'default de Tailwind, sin uso' },
];

const colors = [
  { token: 'gul-bg', class: 'bg-gul-bg', hex: '#0a0a09', desc: 'page canvas' },
  {
    token: 'gul-surface',
    class: 'bg-gul-surface',
    hex: '#171714',
    desc: 'cards, nav pill, footer',
  },
  { token: 'gul-line', class: 'bg-gul-line', hex: '#2c2c27', desc: 'borders on dark surfaces' },
  { token: 'gul-ink', class: 'bg-gul-ink', hex: '#ece7d8', desc: 'headline / emphasis text' },
  {
    token: 'gul-muted',
    class: 'bg-gul-muted',
    hex: '#9c988c',
    desc: 'body text on dark; también el Tux de logo-gul-dark.svg',
  },
];

// Decided: the two brand colours, pulled from the logo rather than invented.
// Single accent pair, shown separately since they're not structural
// (bg/surface/line/ink/muted above are; these are for accents/CTAs).
const brandColors = [
  {
    token: 'gul-blue',
    class: 'bg-gul-blue',
    hex: '#0075b0',
    desc: 'acento primario, enlaces, CTAs',
  },
  {
    token: 'gul-gray',
    class: 'bg-gul-gray',
    hex: '#666666',
    desc: 'Tux de logo-gul.svg, para fondos claros',
  },
];

const faqItems = [
  { q: '¿Cómo me apunto al GUL?', a: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.' },
];
---

<BaseLayout title="Styleguide — GUL">
  <GulHeader links={navLinks} />
  <main class="mx-auto max-w-gul-content space-y-16 p-8">
    <header class="space-y-2 border-b border-gul-line pb-6">
      <h1>Styleguide</h1>
      <p class="text-gul-muted">
        Página de trabajo para decidir la identidad visual compartida. No forma parte del sitio
        público.
      </p>
    </header>

    <h2 class="text-3xl font-semibold text-gul-muted uppercase">Estilos base</h2>

    <section class="space-y-4">
      <h2>Colores</h2>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        {colors.map((c) => (
          <div class="space-y-2">
            <div class={`h-20 rounded-md border border-gul-line ${c.class}`} />
            <p class="text-sm text-gul-ink">{c.token}</p>
            <p class="text-xs text-gul-muted">
              {c.hex} — {c.desc}
            </p>
          </div>
        ))}
      </div>

      <GulFrame border="border-gul-ink/30" class="space-y-4 p-6">
        <p class="text-xs text-gul-muted">
          Decidido: sacados de <code>logo-gul-dark.svg</code>, no inventados. Un solo acento (azul)
          + el gris de Tux — nunca varios colores compitiendo entre sí, eso es lo que mantiene la
          paleta segura para daltonismo.
        </p>
        <div class="mb-4 grid gap-4 sm:grid-cols-3">
          {brandColors.map((c) => (
            <div class="space-y-2">
              <div class={`h-20 rounded-md border border-gul-line ${c.class}`} />
              <p class="text-sm text-gul-ink">{c.token}</p>
              <p class="text-xs text-gul-muted">
                {c.hex} — {c.desc}
              </p>
            </div>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <GulBadge>Badge primario</GulBadge>
          <a href="#" class="text-sm text-gul-blue underline underline-offset-4">
            Enlace con acento
          </a>
        </div>
        <div class="space-y-2">
          <div class="relative h-20 overflow-hidden rounded-md border border-gul-line bg-gul-surface">
            <PixelDissolve />
          </div>
          <p class="text-sm text-gul-ink">PixelDissolve</p>
          <p class="text-xs text-gul-muted">
            fondo de gul-Card / gul-Callout: dithering ordenado (matriz de Bayer + algo de ruido con
            semilla fija) por densidad de celdas de 3px, nunca por opacidad — más denso hacia la
            esquina superior derecha, se apaga antes de llegar a la zona de texto. El marco de este
            mismo recuadro ya lleva la variante "corner" vía <code>gul-Frame</code>.
          </p>
        </div>
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Tipografía</h2>
      <p class="text-xs text-gul-muted">
        Decidido y autohospedado (@fontsource-variable, sin CDN) — tokens reales en
        <code>global.css</code>.
      </p>
      <div class="grid gap-4 sm:grid-cols-3">
        {fontStacks.map((f) => (
          <GulFrame class="space-y-1 p-4">
            <p class={`${f.class} text-lg text-gul-ink`}>Grupo de Usuarios de Linux</p>
            <p class="text-xs text-gul-muted">{f.label}</p>
            <p class={`${f.class} text-xs text-gul-muted`}>áéíóú ñ ¿¡ 0123456789</p>
          </GulFrame>
        ))}
      </div>
    </section>

    <section class="space-y-4">
      <h2>Radios</h2>
      <div class="flex flex-wrap gap-6">
        {radii.map((r) => (
          <div class="space-y-2 text-center">
            <div
              class={`flex h-16 w-16 items-center justify-center border border-gul-line bg-gul-surface ${r.class}`}
            />
            <p class="max-w-24 text-xs text-gul-muted">{r.label}</p>
          </div>
        ))}
      </div>

      <GulFrame border="border-gul-ink/30" class="space-y-4 p-6">
        <p class="text-xs text-gul-muted">
          Regla: <code>rounded-md</code> es siempre el borde exterior. Lo anidado dentro usa
          <code>rounded-inner-N</code>, con la misma N que su padding (<code>p-N</code>), y calcula
          solo <code>radio exterior − N</code> vía <code>calc()</code> — no hay que recalcular nada
          a mano, y si <code>--radius-md</code> cambia algún día, esto se recalcula solo.
        </p>
        <div class="flex flex-wrap gap-6">
          <div class="space-y-2 text-center">
            <div class="rounded-md border border-gul-line bg-gul-surface p-4">
              <div class="rounded-inner-4 flex h-12 w-24 items-center justify-center bg-gul-bg text-xs text-gul-muted">
                p-4
              </div>
            </div>
            <p class="max-w-32 text-xs text-gul-muted">
              p-4 (1rem) &gt; 0.375rem → colapsa a 0, esquina recta
            </p>
          </div>
          <div class="space-y-2 text-center">
            <div class="rounded-md border border-gul-line bg-gul-surface p-1">
              <div class="rounded-inner-1 flex h-12 w-24 items-center justify-center bg-gul-bg text-xs text-gul-muted">
                p-1
              </div>
            </div>
            <p class="max-w-32 text-xs text-gul-muted">
              p-1 (0.25rem) &lt; 0.375rem → radio real de 0.125rem
            </p>
          </div>
        </div>
      </GulFrame>
    </section>

    <p class="text-xs text-gul-muted">
      Regla: sin sombras (<code>shadow-*</code>) en ningún componente, ni siquiera la del pin de
      Leaflet — plano en todas partes, a propósito.
    </p>

    <section class="space-y-4">
      <h2>Espaciado</h2>
      <p class="text-xs text-gul-muted">
        Escala por defecto de Tailwind (pasos de 0.25rem) — sin token propio todavía.
      </p>
      <div class="space-y-2">
        {spacingScale.map((s) => (
          <div class="flex items-center gap-3">
            <div class={`h-4 bg-gul-ink ${s.class}`} />
            <span class="text-xs text-gul-muted">
              {s.class} — {s.px}
            </span>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-4">
      <h2>Breakpoints</h2>
      <table>
        <thead>
          <tr>
            <th>Prefijo</th>
            <th>min-width</th>
            <th>Uso</th>
          </tr>
        </thead>
        <tbody>
          {breakpoints.map((b) => (
            <tr>
              <td>{b.prefix}:</td>
              <td>{b.minWidth}</td>
              <td>{b.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="space-y-4">
      <h2>Foco (accesibilidad)</h2>
      <p class="text-xs text-gul-muted">
        Único patrón real hoy: <code>focus-visible:text-gul-ink</code> en el nav (cambio de color,
        sin anillo). Prueba a navegar con Tab.
      </p>
      <GulFrame class="flex flex-wrap items-center gap-4 p-6">
        <a
          href="#"
          class="rounded-md px-3 py-2 text-sm font-medium text-gul-muted outline-none focus-visible:text-gul-ink"
        >
          Enlace enfocable
        </a>
        <button
          type="button"
          class="rounded-md border border-gul-line px-4 py-2 text-sm font-semibold text-gul-ink outline-none focus-visible:text-gul-muted"
        >
          Botón enfocable
        </button>
      </GulFrame>
    </section>

    <h2 class="text-5xl font-semibold text-gul-muted uppercase">Componentes</h2>

    <section class="space-y-4">
      <h2>Eyebrow</h2>
      <GulFrame class="p-6">
        <GulEyebrow text="Etiqueta antes de un título" />
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Encabezados</h2>
      <GulFrame class="space-y-3 p-6">
        <h1>H1 — Grupo de Usuarios de Linux</h1>
        <h2>H2 — Grupo de Usuarios de Linux</h2>
        <h3>H3 — Grupo de Usuarios de Linux</h3>
        <h4>H4 — Grupo de Usuarios de Linux</h4>
        <h5>H5 — Grupo de Usuarios de Linux</h5>
        <h6>H6 — Grupo de Usuarios de Linux</h6>
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Párrafos</h2>
      <GulFrame class="space-y-4 p-6">
        <p class="text-lg text-gul-ink">
          Párrafo destacado (lead) — para la entradilla de una sección, algo más grande que el
          cuerpo normal.
        </p>
        <p class="text-base leading-relaxed text-gul-muted">
          Párrafo de cuerpo estándar. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed
          do eiusmod tempor incididunt ut labore et dolore magna aliqua. Un enlace dentro de texto
          se ve
          <a
            href="#"
            class="text-gul-ink underline decoration-gul-muted underline-offset-4 hover:text-gul-ink/80"
          >
            así
          </a>
          .
        </p>
        <p class="text-sm text-gul-muted">Texto pequeño — pies de foto, notas, metadatos.</p>
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Cita</h2>
      <GulFrame class="p-6">
        <figure>
          <blockquote>«El software libre es una cuestión de libertad, no de precio.»</blockquote>
          <figcaption>Richard Stallman</figcaption>
        </figure>
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Código y teclado</h2>
      <GulFrame class="space-y-4 p-6">
        <GulCodeBlock>sudo apt update &amp;&amp; sudo apt upgrade</GulCodeBlock>
        <p class="text-sm text-gul-muted">
          Código inline, como <code>apt-get</code>, dentro de una frase.
        </p>
        <p class="text-sm text-gul-muted">
          Abre una terminal con <kbd>Ctrl</kbd> + <kbd>Alt</kbd> + <kbd>T</kbd>
        </p>
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Terminal</h2>
      <GulFrame class="p-6">
        <GulTerminal
          lines={[
            { command: 'whoami' },
            {
              command: 'hostnamectl | grep Location # Dirección',
              output: 'Location: Avenida de la Universidad, 30, 28911 Leganés, Madrid',
            },
          ]}
        />
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Listas</h2>
      <GulFrame class="grid gap-6 p-6 sm:grid-cols-2">
        <div>
          <p class="mb-2 text-sm text-gul-muted">
            Sin ordenar (bullet-icon Tux: idea abierta, issue #5)
          </p>
          <GulList items={['Primer elemento', 'Segundo elemento', 'Tercer elemento']} />
        </div>
        <div>
          <p class="mb-2 text-sm text-gul-muted">Ordenada</p>
          <GulList ordered items={['Primer paso', 'Segundo paso', 'Tercer paso']} />
        </div>
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Commits grid</h2>
      <GulCommitsGrid />
    </section>

    <section class="space-y-4">
      <h2>Divisor</h2>
      <hr />
    </section>

    <section class="space-y-4">
      <h2>Cards</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <GulCard
          href="#"
          index="01"
          title="Título de la card"
          description="Descripción corta de una línea o dos sobre el contenido."
        />
        <GulCard
          href="#"
          index="02"
          title="Otra card"
          description="Mismo componente que las de Proyectos, reutilizado aquí."
        />
      </div>
      <GulRepoCard
        href="https://github.com/guluc3m/report-template-typst"
        name="report-template-typst"
        description="Plantilla de Typst para memorias de trabajos, laboratorios, etc. de la UC3M"
        language="Typst"
        stars={12}
        forks={4}
        badge="Public template"
      />
    </section>

    <section class="space-y-4">
      <h2>Acordeón</h2>
      <GulAccordion items={faqItems} />
    </section>

    <section class="space-y-4">
      <h2>Tabs</h2>
      <GulTabs
        tabs={[
          { id: 'instalacion', label: 'Instalación' },
          { id: 'configuracion', label: 'Configuración' },
        ]}
      >
        <Fragment slot="instalacion">Contenido de la primera pestaña.</Fragment>
        <Fragment slot="configuracion">Contenido de la segunda pestaña.</Fragment>
      </GulTabs>
    </section>

    <section class="space-y-4">
      <h2>Modal</h2>
      <GulFrame class="p-6">
        <GulModal id="demo-modal" triggerLabel="Abrir modal" title="Título del modal">
          Contenido de ejemplo. Nativo (&lt;dialog&gt;), sin librería.
        </GulModal>
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Galería</h2>
      <p class="text-xs text-gul-muted">
        Expansión al pasar el ratón con flex + <code>:has()</code>, sin JS; clic abre un
        &lt;dialog&gt; nativo a pantalla completa con anterior/siguiente.
      </p>
      <GulFrame class="p-6">
        <GulGallery
          id="demo-gallery"
          images={[
            { src: '/real/teclados.jpeg', alt: 'Taller teclados' },
            { src: '/real/teclados2.jpeg', alt: 'Taller teclados (2)' },
            { src: '/real/feria.jpg', alt: 'Feria de Asociaciones' },
          ]}
        />
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Campos de formulario</h2>
      <GulFrame class="grid gap-4 p-6 sm:grid-cols-2">
        <label class="block space-y-1">
          <span class="font-medium text-gul-ink">Nombre</span>
          <input type="text" placeholder="Ada Lovelace" />
        </label>
        <label class="block space-y-1">
          <span class="font-medium text-gul-ink">Mensaje</span>
          <textarea rows="1" placeholder="Escribe aquí…"></textarea>
        </label>
        <label class="block space-y-1">
          <span class="font-medium text-gul-ink">Comisión</span>
          <select>
            <option>Sysadmin</option>
            <option>Seguridad</option>
            <option>Eventos</option>
          </select>
        </label>
        <fieldset class="space-y-1 text-sm">
          <legend class="font-medium text-gul-ink">Nivel</legend>
          <label class="flex items-center gap-2">
            <input type="radio" name="nivel" />
            Principiante
          </label>
          <label class="flex items-center gap-2">
            <input type="radio" name="nivel" />
            Con experiencia
          </label>
        </fieldset>
        <label class="flex items-center gap-2">
          <input type="checkbox" />
          Acepto los términos
        </label>
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Badges</h2>
      <GulFrame class="flex flex-wrap items-center gap-3 p-6">
        <GulBadge variant="primary">Primario</GulBadge>
        <GulBadge variant="secondary">Secundario</GulBadge>
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2>Tabla</h2>
      <table>
        <thead>
          <tr>
            <th>Token</th>
            <th>Uso</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>gul-surface</td>
            <td>Cards, nav pill, footer</td>
          </tr>
          <tr>
            <td>gul-line</td>
            <td>Bordes sobre superficies oscuras</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="space-y-4">
      <h2>Aviso (callout)</h2>
      <p class="text-xs text-gul-muted">
        Se diferencian por icono + etiqueta, no por color: la paleta (issue #5) es monocroma a
        propósito por accesibilidad daltónica. Añadir rojo/verde semántico requeriría el visto bueno
        del mantenedor.
      </p>
      <div class="space-y-3">
        <GulCallout variant="warning" label="Aviso">
          Información neutra sobre algo que conviene saber.
        </GulCallout>
        <GulCallout variant="success" label="Éxito">
          La acción se ha completado correctamente.
        </GulCallout>
        <GulCallout variant="error" label="Error">
          Algo ha ido mal y hay que corregirlo.
        </GulCallout>
      </div>
    </section>

    <section class="space-y-4">
      <h2>Botones y enlaces</h2>
      <GulFrame class="flex flex-wrap items-center gap-4 p-6">
        <GulButton variant="primary" label="Botón primario" />
        <GulButton variant="secondary" label="Botón secundario" />
        <GulContactDropdown id="gul-contact-menu-styleguide" />
        <a
          href="#"
          class="inline-flex items-center gap-1 font-mono text-sm text-gul-ink underline decoration-gul-muted underline-offset-4 hover:text-gul-muted"
        >
          <span aria-hidden="true" class="text-gul-blue">
            »
          </span>
          Enlace de texto
        </a>
      </GulFrame>
    </section>

    <section class="space-y-4">
      <h2 class="text-3xl font-bold text-gul-ink">Logro</h2>
      <p class="text-sm text-gul-muted">
